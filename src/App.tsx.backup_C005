            <button
              type="button"
              onClick={() => handlePlayTrack(currentTrack)}
              className="w-6 h-6 border border-white flex items-center justify-center text-black bg-white hover:bg-[#dddddd] transition-colors flex-shrink-0"
              aria-label={isPlaying ? 'Pause' : 'Play'}
              title={isPlaying ? 'Pause [Space]' : 'Play [Space]'}
            >
              {isPlaying ? <Pause className="w-3 h-3 fill-current" /> : <Play className="w-3 h-3 fill-current" />}
            </button>
            <span className="font-bold text-white uppercase text-[11px] truncate max-w-[240px]">
              [BANK {getTrackBank(currentTrack)}] {currentTrack.catalogId}: {currentTrack.title}
            </span>
            <button
              type="button"
              onClick={() => setIsDockDismissed(false)}
              className="border border-white bg-[#141414] text-white hover:bg-white hover:text-black px-2 py-0.5 text-[10px] font-bold uppercase"
              title="Expand floating player dock"
            >
              [ + EXPAND ]
            </button>
          </aside>
        ) : (
          <aside className="fixed bottom-0 left-0 right-0 z-50 bg-[#070709]/95 backdrop-blur-md border-t-2 border-white py-1.5 px-3 sm:px-5 shadow-[0_-8px_24px_rgba(0,0,0,0.95)] font-mono transition-transform duration-200">
            <div className="max-w-[1360px] mx-auto flex items-center justify-between gap-2.5 text-xs">
              {/* Left: Signal Pulse, Prev / Play / Next / Stop & Track Info */}
              <div className="flex items-center gap-1 sm:gap-1.5 min-w-0">
                <span 
                  className={`w-2 h-2 rounded-full flex-shrink-0 ${
                    isPlaying 
                      ? 'bg-white shadow-[0_0_8px_#ffffff] animate-pulse' 
                      : 'bg-[#444444]'
                  }`} 
                  title={isPlaying ? 'Auditioning Live Master Audio' : 'Audition Paused'}
                />

                {/* Prev Track */}
                <button
                  type="button"
                  onClick={handlePrevTrack}
                  className="w-6 h-6 border border-[#444444] bg-[#121212] text-[#cccccc] hover:border-white hover:text-white flex items-center justify-center transition-colors flex-shrink-0"
                  aria-label="Previous track"
                  title="Previous track"
                >
                  <SkipBack className="w-3 h-3 fill-current" />
                </button>

                {/* Play / Pause Toggle */}
                <button
                  type="button"
                  onClick={() => handlePlayTrack(currentTrack)}
                  className="w-6 h-6 border border-white flex items-center justify-center text-black bg-white hover:bg-[#dddddd] transition-colors flex-shrink-0"
                  aria-label={isPlaying ? 'Pause' : 'Play'}
                  title={isPlaying ? 'Pause [Space]' : 'Play [Space]'}
                >
                  {isPlaying ? <Pause className="w-3 h-3 fill-current" /> : <Play className="w-3 h-3 fill-current" />}
                </button>

                {/* Next Track */}
                <button
                  type="button"
                  onClick={handleNextTrack}
                  className="w-6 h-6 border border-[#444444] bg-[#121212] text-[#cccccc] hover:border-white hover:text-white flex items-center justify-center transition-colors flex-shrink-0"
                  aria-label="Next track"
                  title="Next track"
                >
                  <SkipForward className="w-3 h-3 fill-current" />
                </button>

                {/* Stop Button */}
                <button
                  type="button"
                  onClick={handleStopTrack}
                  className="w-6 h-6 border border-[#333333] bg-[#121212] text-[#777777] hover:border-white hover:text-white hover:bg-[#1e1e1e] flex items-center justify-center transition-colors flex-shrink-0"
                  aria-label="Stop playback"
                  title="Stop playback"
                >
                  <Square className="w-2.5 h-2.5 fill-current" />
                </button>

                {/* Track Metadata */}
                <div className="truncate ml-1 flex items-center gap-1.5 min-w-0">
                  <span className="text-[10px] bg-[#1a1a1a] text-white border border-[#444444] px-1.5 py-0 font-bold uppercase whitespace-nowrap">
                    SOURCE: [BANK {getTrackBank(currentTrack)}]
                  </span>
                  <span className="font-bold text-white uppercase text-[11px] whitespace-nowrap">{currentTrack.catalogId} //</span>
                  <span className="text-[#dddddd] uppercase text-[11px] truncate max-w-[120px] sm:max-w-[200px] md:max-w-[260px]">{currentTrack.title}</span>
                  <span className="text-[9px] bg-[#141414] text-white border border-[#333333] px-1 py-0 hidden md:inline font-bold uppercase whitespace-nowrap">
                    24-BIT WAV
                  </span>
                  <span className="text-[9px] text-[#888888] hidden lg:inline whitespace-nowrap">
                    [{currentTrack.bpm ? `${currentTrack.bpm} BPM` : 'FREE TEMPO'} &bull; {currentTrack.key}]
                  </span>
                </div>
              </div>

              {/* Center: Audio Scrubber + 2/4/8 Bars Loop + Continuous Audition Toggle */}
              <div className="hidden md:flex items-center gap-2 flex-1 max-w-lg mx-2">
                <span className="text-[10px] text-[#888888] w-8 text-right font-mono">
                  {formatSeconds(currentTime)}
                </span>
                <input
                  type="range"
                  min="0"
                  max={currentTrack.durationSec}
                  step="0.1"
                  value={currentTime}
                  onChange={(e) => setCurrentTime(Number(e.target.value))}
                  className="flex-1 h-1 bg-[#222222] rounded-none appearance-none cursor-pointer accent-white"
                />
                <span className="text-[10px] text-[#888888] w-8 font-mono">
                  {currentTrack.duration}
                </span>

                {/* 2 / 4 / 8 Bar Loop Buttons in Floating Player */}
                <div className="flex items-center gap-0.5">
                  {([2, 4, 8] as LoopBarOption[]).map((bars) => (
                    <button
                      key={bars}
                      type="button"
                      onClick={() => handleToggleBarLoop(bars)}
                      className={`text-[9px] px-1 py-0.5 border uppercase font-bold transition-colors ${
                        loopBars === bars
                          ? 'border-white bg-white text-black'
                          : 'border-[#333333] text-[#888888] hover:text-white'
                      }`}
                      title={`Loop ${bars} bars`}
                    >
                      {bars}B
                    </button>
                  ))}
                </div>

                {/* Continuous Audition Auto-Advance Indicator / Toggle */}
                <button
                  type="button"
                  onClick={() => setAutoAdvance(!autoAdvance)}
