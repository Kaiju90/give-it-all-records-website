export type MoodCategory = 'ALL' | 'TENSION & DARK' | 'DRIVING & ENERGETIC' | 'SPARSE & AMBIENT' | 'BOUNCY & GROOVE' | 'RAW & AGGRESSIVE';
export type GenreFilter = 'ALL' | 'ELECTRONIC / IDM' | 'HIP-HOP / BOOM BAP' | 'ALT ROCK / NOISE' | 'EXPERIMENTAL';
export type StemSoloMode = 'master' | 'drums' | 'bass' | 'synths';
export type LoopBarOption = 2 | 4 | 8;

export type BankId = 'A' | 'B' | 'C' | 'D';

export interface BankConfig {
  id: BankId;
  name: string;
  subtitle: string;
}

export const BANKS: BankConfig[] = [
  { id: 'A', name: 'BANK A', subtitle: 'ELECTRONIC / IDM' },
  { id: 'B', name: 'BANK B', subtitle: 'HIP-HOP / BOOM BAP' },
  { id: 'C', name: 'BANK C', subtitle: 'ALT ROCK / NOISE' },
  { id: 'D', name: 'BANK D', subtitle: 'EXPERIMENTAL' },
];

export interface Track {
  id: string;
  catalogId: string;
  title: string;
  bank?: BankId;
  genre: 'Electronic' | 'Hip-Hop' | 'Alt Rock / Noise' | 'Experimental';
  subgenre: string;
  moodPrimary: 'TENSION & DARK' | 'DRIVING & ENERGETIC' | 'SPARSE & AMBIENT' | 'BOUNCY & GROOVE' | 'RAW & AGGRESSIVE';
  moodTags: string[];
  bpm?: number | null; // Optional: unquantized/experimental tracks have no BPM
  key?: string | null; // Optional: experimental drone/noise tracks have no fixed key
  isExperimental?: boolean;
  dropTimestampSec: number;
  duration: string;
  durationSec: number;
  specs: string;
  priceUsd: number;
  hasStems: boolean;
  stemPriceUsd: number;
  stemsBreakdown?: string[];
  companionCatalogId: string;
  companionTitle: string;
  wooCommerceId: number;
  description: string;
}

export interface AuditionLogEntry {
  id: string;
  catalogId: string;
  title: string;
  sourceBank: BankId;
  bpm?: number | null;
  key?: string | null;
  duration: string;
  durationSec: number;
  trackRef: Track;
}

export const getTrackBank = (track: Track): BankId => track.bank || 'A';

