                </span>
                {showLicenseScope ? <ChevronUp className="w-3.5 h-3.5" /> : <ChevronDown className="w-3.5 h-3.5" />}
              </button>

              {showLicenseScope && (
                <div className="p-3 border-t border-[#222222] text-[10px] text-[#aaaaaa] space-y-1.5 leading-relaxed">
                  <div>&bull; <strong className="text-white">PERPETUAL CLEARANCE:</strong> Non-exclusive synchronization and distribution rights that never expire worldwide for video games, YouTube, podcasts, and indie films.</div>
                  <div>&bull; <strong className="text-white">COMMERCIAL CEILING ($2,000 / 100K STREAMS):</strong> Covers production earnings up to $2,000 USD gross or 100,000 streams. If gross revenue exceeds $2,000, licensee agrees to contact Give It All Records for a standard commercial upgrade / split agreement.</div>
                  <div>&bull; <strong className="text-white">VOCAL LEASE:</strong> Emcees and vocalists are cleared to record original vocal tracks and distribute them commercially.</div>
                  <div>&bull; <strong className="text-white">CUE SHEETS:</strong> For broadcast TV, cable, and theatrical movies, credit Luciano Lupini (100% Composer / 100% Publisher).</div>
                </div>
              )}
            </div>

            {/* Payment Options */}
            <div className="border border-white p-2.5 mb-3 bg-[#0a0a0a]">
              <span className="text-[10px] text-[#888888] block uppercase tracking-wider mb-1.5">
                SELECT PAYMENT METHOD:
              </span>
              <div className="space-y-1 text-xs">
                <button
                  type="button"
                  onClick={() => setActivePaymentRail('crypto')}
                  className={`w-full text-left p-1.5 border uppercase flex items-center justify-between transition-all ${
                    activePaymentRail === 'crypto'
                      ? 'border-white bg-white text-black font-bold'
                      : 'border-[#333333] text-[#aaaaaa] hover:border-white hover:text-white'
                  }`}
                >
                  <span>[1] CRYPTO (USDT / BTC / ETH DIRECT)</span>
                  {activePaymentRail === 'crypto' && <Check className="w-3.5 h-3.5 text-black" />}
