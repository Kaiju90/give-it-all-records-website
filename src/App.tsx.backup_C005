                    autoAdvance
                      ? 'border-white bg-[#181818] text-white'
                      : 'border-[#333333] text-[#666666] hover:text-white'
                  }`}
                  title="Continuous Audition: Automatically transition to next track upon finish"
                >
                  <Repeat className="w-2.5 h-2.5" />
                  <span>AUTO: {autoAdvance ? 'ON' : 'OFF'}</span>
                </button>

                {/* Stem Solo Quick Switch */}
                {currentTrack.hasStems && (
                  <div className="hidden xl:flex items-center gap-1 border-l border-[#222222] pl-2">
