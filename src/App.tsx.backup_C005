                        onClick={() => handleStemSoloSwitch(mode)}
                        className={`text-[9px] px-1 py-0.2 border uppercase ${
                          activeStemSolo === mode
                            ? 'border-white bg-white text-black font-bold'
                            : 'border-[#222222] text-[#777777] hover:text-white'
                        }`}
                      >
                        {mode[0].toUpperCase()}
