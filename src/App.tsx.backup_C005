            </div>
          </div>
          <p className="text-[10px] text-[#444444]">
            INDEPENDENT AUDIO CATALOG &bull; 100% DIRECT RIGHTS &bull; ZERO THIRD-PARTY PRO COMMISSIONS
          </p>
        </footer>
      </div>

      {/* ================================================================================== */}
      {/* PERSISTENT FLOATING MINI-PLAYER BAR (ALWAYS ON // MINIMIZE & EXPAND READY)          */}
      {/* ================================================================================== */}
      {(hasStartedPlaying || currentTrack) && currentTrack && (
