                      : 'border-[#333333] text-white hover:border-white'
                  }`}
                >
                  MULTI-TRACK STEMS ($25)
                </button>
              </div>
            )}

            {/* Stems Content Breakdown */}
            {modalTier === 'stems' && modalTrack.stemsBreakdown && (
              <div className="border border-[#444444] bg-[#0e0e0e] p-2.5 mb-3 text-[11px]">
                <span className="text-white font-bold block mb-1">
                  [✓ INCLUDES SEPARATED 24-BIT WAV STEMS + STEREO MASTER]:
                </span>
                <div className="flex flex-wrap gap-1 text-[10px] text-white">
                  {modalTrack.stemsBreakdown.map((stem) => (
                    <span key={stem} className="border border-[#333333] bg-black px-1.5 py-0.5">
                      &bull; {stem}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <div className="space-y-1.5 mb-3 text-xs">
              <div className="flex justify-between border-b border-[#222222] pb-1">
                <span className="text-[#888888]">CATALOG ID:</span>
                <span className="text-white">{modalTrack.catalogId}</span>
              </div>
              <div className="flex justify-between border-b border-[#222222] pb-1">
                <span className="text-[#888888]">PACKAGE TIER:</span>
                <span className="text-white font-bold">
                  {modalTier === 'master' ? '24-BIT STEREO MASTER WAV ($10)' : 'SEPARATED MULTI-TRACK STEMS + MASTER ($25)'}
                </span>
              </div>
              <div className="flex justify-between border-b border-[#222222] pb-1">
                <span className="text-[#888888]">LICENSE DURATION:</span>
                <span className="text-white font-bold">PERPETUAL (NEVER EXPIRES)</span>
              </div>
              <div className="flex justify-between border-b border-[#222222] pb-1">
                <span className="text-[#888888]">COMMERCIAL CEILING:</span>
                <span className="text-white">UP TO $2,000 GROSS / 100,000 STREAMS</span>
              </div>
              <div className="flex justify-between border-b border-[#222222] pb-1">
                <span className="text-[#888888]">TOTAL DUE:</span>
                <span className="text-white font-bold text-base">
                  ${(modalTier === 'master' ? modalTrack.priceUsd : modalTrack.stemPriceUsd).toFixed(2)} USD
                </span>
              </div>
            </div>

            {/* Plain-English License Terms Toggle */}
            <div className="border border-[#333333] mb-3 bg-[#0a0a0a]">
              <button
                type="button"
                onClick={() => setShowLicenseScope(!showLicenseScope)}
                className="w-full text-left p-2 text-[11px] text-white flex justify-between items-center hover:bg-[#111111]"
