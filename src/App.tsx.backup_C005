        >
          <div className="border-2 border-white bg-black max-w-lg w-full p-5 md:p-6 shadow-[0_0_30px_rgba(255,255,255,0.2)] font-mono">
            <div className="border-b-2 border-white pb-3 mb-3 flex justify-between items-start">
              <div>
                <span className="text-[10px] text-[#aaaaaa] uppercase tracking-wider block font-bold">
                  DIRECT ACQUISITION // PERPETUAL INDIE LICENSE
                </span>
                <h3 className="text-lg font-bold uppercase tracking-wider text-white">
                  {modalTrack.title}
                </h3>
              </div>
              <span className="border border-white px-2 py-0.5 text-xs font-bold uppercase text-white">
                {modalTrack.catalogId}
              </span>
            </div>

            {/* Tier Selector */}
            {modalTrack.hasStems && (
              <div className="border border-[#333333] p-1.5 mb-3 bg-[#0a0a0a] flex gap-2 text-xs">
                <button
                  type="button"
                  onClick={() => setModalTier('master')}
                  className={`flex-1 py-1.5 border uppercase transition-all ${
                    modalTier === 'master'
                      ? 'border-white bg-white text-black font-bold'
                      : 'border-[#333333] text-[#888888] hover:text-white'
                  }`}
                >
                  STEREO MASTER ($10)
                </button>
                <button
                  type="button"
                  onClick={() => setModalTier('stems')}
                  className={`flex-1 py-1.5 border uppercase transition-all ${
                    modalTier === 'stems'
