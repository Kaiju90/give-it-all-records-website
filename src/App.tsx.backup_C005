                  className="border border-white bg-white text-black font-bold text-[10px] sm:text-[11px] uppercase px-2.5 sm:px-3 py-1 hover:bg-black hover:text-white transition-all flex items-center gap-1 whitespace-nowrap phosphor-hover"
                >
                  <span>ACQUIRE $10</span>
                  <ArrowUpRight className="w-3 h-3 stroke-[2.5]" />
                </button>

                {currentTrack.hasStems && (
                  <button
                    type="button"
                    onClick={() => {
                      setModalTrack(currentTrack);
                      setModalTier('stems');
                    }}
                    className="border border-[#555555] bg-[#141414] text-white hover:bg-white hover:text-black font-bold text-[10px] sm:text-[11px] uppercase px-2 sm:px-2.5 py-1 transition-all flex items-center gap-1 whitespace-nowrap"
                  >
                    <span>STEMS $25</span>
                    <ArrowUpRight className="w-3 h-3 stroke-[2.5]" />
                  </button>
                )}

                <button
                  type="button"
                  onClick={() => setIsDockDismissed(true)}
                  className="text-[#888888] hover:text-white border border-[#333333] hover:border-white px-1.5 py-0.5 text-[10px] font-bold uppercase ml-0.5"
                  title="Minimize floating player dock"
                  aria-label="Minimize floating player dock"
                >
                  [ − ]
                </button>
              </div>
            </div>
          </aside>
        )
      )}

      {/* ================================================================================== */}
      {/* CHECKOUT MODAL ($10 PERPETUAL MASTER / $25 STEMS + $2K CEILING TERMS)             */}
      {/* ================================================================================== */}
      {modalTrack && (
        <div
          role="dialog"
          aria-modal="true"
