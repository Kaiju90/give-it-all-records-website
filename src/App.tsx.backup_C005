                  <span>[2] ONLINE CHECKOUT GATEWAY</span>
                  {activePaymentRail === 'direct' && <Check className="w-3.5 h-3.5 text-black" />}
                </button>

                <button
                  type="button"
                  onClick={() => setActivePaymentRail('email')}
                  className={`w-full text-left p-1.5 border uppercase flex items-center justify-between transition-all ${
                    activePaymentRail === 'email'
                      ? 'border-white bg-white text-black font-bold'
                      : 'border-[#333333] text-[#aaaaaa] hover:border-white hover:text-white'
                  }`}
                >
                  <span>[3] DIRECT EMAIL ORDER (MANUAL INVOICE)</span>
                  {activePaymentRail === 'email' && <Check className="w-3.5 h-3.5 text-black" />}
                </button>
              </div>
            </div>

            {/* Action Buttons */}
            <div className="flex flex-col gap-2">
              {activePaymentRail === 'crypto' ? (
                <a
                  href={`https://giveitallrecords.com/shop/?add-to-cart=${modalTrack.wooCommerceId}`}
                  target="_blank"
                  rel="noreferrer"
                  className="w-full text-center py-2.5 bg-white text-black font-bold uppercase text-xs tracking-wider border-2 border-white hover:bg-black hover:text-white transition-all flex items-center justify-center gap-1.5"
                >
                  <span>PROCEED TO DIRECT CHECKOUT</span>
                  <ExternalLink className="w-3.5 h-3.5" />
                </a>
              ) : activePaymentRail === 'direct' ? (
                <a
                  href={`https://giveitallrecords.com/shop/?add-to-cart=${modalTrack.wooCommerceId}`}
                  target="_blank"
                  rel="noreferrer"
                  className="w-full text-center py-2.5 bg-white text-black font-bold uppercase text-xs tracking-wider border-2 border-white hover:bg-black hover:text-white transition-all flex items-center justify-center gap-1.5"
                >
                  <span>PROCEED TO PAYMENT TERMINAL</span>
                  <ExternalLink className="w-3.5 h-3.5" />
                </a>
              ) : (
                <a
                  href={`mailto:contact@giveitallrecords.com?subject=ORDER%20//%20${encodeURIComponent(
                    modalTrack.title
                  )}%20//%20${modalTier.toUpperCase()}&body=TRACK:%20${encodeURIComponent(
                    modalTrack.title
                  )}%0ACATALOG:%20${
                    modalTrack.catalogId
                  }%0ATIER:%20${modalTier.toUpperCase()}%0APRICE:%20$${
                    modalTier === 'master' ? modalTrack.priceUsd : modalTrack.stemPriceUsd
                  }%0ALICENSE:%20PERPETUAL%20NON-EXCLUSIVE%20(UP%20TO%20$2,000%20REVENUE)`}
                  className="w-full text-center py-2.5 bg-white text-black font-bold uppercase text-xs tracking-wider border-2 border-white hover:bg-black hover:text-white transition-all flex items-center justify-center gap-1.5"
                >
                  <span>LAUNCH PRE-FILLED EMAIL ORDER</span>
                  <Mail className="w-3.5 h-3.5" />
                </a>
              )}

              <button
                type="button"
                onClick={() => setModalTrack(null)}
                className="w-full py-2 bg-transparent text-white border border-[#444444] text-xs uppercase hover:border-white transition-colors"
              >
                CLOSE / RETURN TO CATALOG
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ================================================================================== */}
      {/* 1-CLICK SAMPLE CLEARANCE CERTIFICATE MODAL                                         */}
      {/* ================================================================================== */}
      {certificateTrack && (
        <div
          role="dialog"
          aria-modal="true"
          className="fixed inset-0 z-50 bg-black/95 flex items-center justify-center p-4 overflow-y-auto print-only-modal"
        >
          <div className="border-2 border-white bg-[#080808] max-w-2xl w-full p-6 md:p-8 font-mono print-certificate-card shadow-[0_0_35px_rgba(255,255,255,0.18)]">
            <div className="border-b-2 border-white pb-3 mb-4 flex justify-between items-start">
              <div>
                <div className="flex items-center gap-2 text-white text-xs font-bold uppercase tracking-wider mb-1">
                  <ShieldCheck className="w-4 h-4 fill-current" />
                  <span>OFFICIAL MASTER USE &amp; SYNCHRONIZATION CERTIFICATE</span>
                </div>
                <h3 className="text-xl font-bold uppercase text-white tracking-widest">
                  GIVE IT ALL RECORDS // CARACAS SOUND LAB
                </h3>
                <span className="text-[10px] text-[#888888]">
                  CERTIFICATE ID: GIAR-SYNC-{certificateTrack.catalogId}-2026
                </span>
              </div>
              <div className="border border-white bg-black text-white px-2 py-1 text-right text-[10px] font-bold">
                100% DIRECT<br/>RIGHTS
              </div>
            </div>

            <div className="space-y-3 text-xs text-[#cccccc] mb-6 leading-relaxed">
              <div className="border border-[#333333] bg-black p-3 space-y-1">
                <div className="flex justify-between"><span className="text-[#888888]">TRACK TITLE:</span> <strong className="text-white uppercase">{certificateTrack.title}</strong></div>
                <div className="flex justify-between"><span className="text-[#888888]">CATALOG ID:</span> <span className="text-white">{certificateTrack.catalogId}</span></div>
                <div className="flex justify-between"><span className="text-[#888888]">COMPOSER &amp; PRODUCER:</span> <span className="text-white">Luciano Lupini (Caracas, Venezuela)</span></div>
                <div className="flex justify-between"><span className="text-[#888888]">AUDIO SPECIFICATION:</span> <span className="text-white">24-Bit / 48kHz Direct PCM WAV</span></div>
                <div className="flex justify-between"><span className="text-[#888888]">TEMPO &amp; KEY:</span> <span className="text-white">{certificateTrack.bpm ? `${certificateTrack.bpm} BPM // ${certificateTrack.key}` : 'Free Tempo / Unquantized Master'}</span></div>
              </div>

              <div>
                <h4 className="text-xs font-bold text-white uppercase tracking-wider mb-1">
                  I. GRANT OF PERPETUAL SYNCHRONIZATION RIGHTS
                </h4>
                <p className="text-[11px] text-[#aaaaaa]">
                  Give It All Records grants the purchaser a perpetual, worldwide, non-exclusive synchronization license to incorporate and reproduce the sound recording into visual and multimedia productions, including indie films, video games, YouTube/Twitch broadcasts, podcasts, and trailers.
                </p>
              </div>

              <div>
                <h4 className="text-xs font-bold text-white uppercase tracking-wider mb-1">
                  II. COMMERCIAL CEILING &amp; REVENUE SHARING
                </h4>
                <p className="text-[11px] text-[#aaaaaa]">
                  The license covers commercial projects generating up to $2,000 USD gross revenue or 100,000 streams. If a production exceeds $2,000 USD in gross receipts, licensee is required to contact Give It All Records (contact@giveitallrecords.com) for a standard master buyout extension.
                </p>
              </div>

              <div>
                <h4 className="text-xs font-bold text-white uppercase tracking-wider mb-1">
                  III. 100% DIRECT RIGHTS &amp; WARRANTY
                </h4>
                <p className="text-[11px] text-[#aaaaaa]">
                  Licensor warrants that Luciano Lupini is the sole composer, performer, mixer, and master rights owner. The sound recording contains zero uncleared third-party samples. The licensee is fully indemnified and held harmless against third-party copyright claims.
                </p>
              </div>

              <div className="border-t border-[#333333] pt-2 text-[10px] text-[#777777] flex justify-between items-center">
                <span>SEAL: CARACAS MASTER ARCHIVE</span>
                <span className="text-white font-bold">LUCIANO LUPINI &bull; COMPOSER &amp; MASTER OWNER</span>
              </div>
            </div>

            <div className="flex flex-wrap items-center justify-between gap-2 border-t border-[#333333] pt-4 no-print">
              <div className="flex items-center gap-2">
                <button
                  type="button"
                  onClick={() => window.print()}
                  className="border-2 border-white bg-white text-black font-bold text-xs uppercase px-3 py-1.5 hover:bg-black hover:text-white transition-all flex items-center gap-1.5"
                >
                  <Printer className="w-3.5 h-3.5" />
                  <span>PRINT / EXPORT PDF</span>
                </button>

                <button
                  type="button"
                  onClick={() => handleCopyCertificate(certificateTrack)}
                  className="border border-[#444444] text-[#cccccc] hover:text-white hover:border-white text-xs uppercase px-3 py-1.5 transition-all flex items-center gap-1.5 bg-[#0a0a0a]"
                >
                  <Copy className="w-3.5 h-3.5" />
                  <span>{certificateCopied ? '✓ CERTIFICATE COPIED' : 'COPY CERTIFICATE TEXT'}</span>
                </button>
              </div>

              <button
                type="button"
                onClick={() => setCertificateTrack(null)}
                className="border border-[#555555] text-white hover:border-white text-xs uppercase px-3 py-1.5"
              >
                ✕ CLOSE
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ================================================================================== */}
      {/* 6. DEDICATED PROJECT CRATE MODAL / DRAWER                                          */}
      {/* ================================================================================== */}
      {isCrateOpen && (
        <div
          role="dialog"
          aria-modal="true"
          className="fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-3 sm:p-5 overflow-y-auto"
        >
          <div className="border-2 border-white bg-black max-w-2xl w-full p-4 sm:p-6 shadow-[0_0_40px_rgba(255,255,255,0.2)] font-mono">
            {/* Modal Header */}
            <div className="border-b-2 border-white pb-3 mb-4 flex justify-between items-start gap-2">
              <div>
                <div className="flex items-center gap-2 text-white text-xs font-bold uppercase tracking-wider mb-0.5">
                  <ShoppingBag className="w-4 h-4 fill-current" />
                  <span>PROJECT CRATE // BUNDLE ACQUISITION</span>
                </div>
                <h3 className="text-lg sm:text-xl font-bold uppercase text-white tracking-wider">
                  {favorites.length} {favorites.length === 1 ? 'TRACK SELECTED' : 'TRACKS SELECTED'}
                </h3>
                <span className="text-[10px] text-[#888888]">
                  PERPETUAL NON-EXCLUSIVE INDIE LICENSE &bull; 100% DIRECT RIGHTS
                </span>
              </div>

              <button
                type="button"
                onClick={() => setIsCrateOpen(false)}
                className="border border-[#444444] text-[#aaaaaa] hover:border-white hover:text-white p-1 text-xs"
                title="Close Crate"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Bundle Discount Tier Ladder */}
            <div className="border border-[#333333] bg-[#0a0a0a] p-2.5 mb-4 text-xs">
              <div className="text-[10px] text-white font-bold uppercase mb-1.5 flex justify-between items-center">
                <span>BUNDLE SAVINGS LADDER:</span>
                <span>
                  {favorites.length === 0 && 'ADD TRACKS TO UNLOCK DISCOUNTS'}
                  {favorites.length === 1 && 'ADD 2 MORE TRACKS FOR $25 BUNDLE (SAVE $5)'}
                  {favorites.length === 2 && 'ADD 1 MORE TRACK FOR $25 BUNDLE (SAVE $5)'}
                  {favorites.length === 3 && '✓ 3-MASTER BUNDLE ACTIVE (SAVED $5.00)'}
                  {favorites.length === 4 && 'ADD 1 MORE TRACK FOR $40 EP PACK (SAVE $10)'}
                  {favorites.length >= 5 && favorites.length < 8 && `✓ 5-MASTER EP PACK ACTIVE (SAVED $${shortlistPricing.savings}.00)`}
                  {favorites.length >= 8 && `✓ FULL SOUNDTRACK PACK ACTIVE (SAVED $${shortlistPricing.savings}.00)`}
                </span>
              </div>

              <div className="grid grid-cols-2 sm:grid-cols-4 gap-1.5 text-[10px]">
                <div className={`p-1.5 border text-center ${
                  favorites.length >= 1 && favorites.length <= 2 
                    ? 'border-white bg-[#181818] text-white font-bold' 
                    : 'border-[#222222] bg-black text-[#666666]'
                }`}>
                  <span className="block">1-2 TRACKS</span>
                  <span className="text-white font-bold">$10 / EACH</span>
                </div>
                <div className={`p-1.5 border text-center ${
                  favorites.length >= 3 && favorites.length <= 4 
                    ? 'border-white bg-white text-black font-bold shadow-[0_0_8px_rgba(255,255,255,0.25)]' 
                    : 'border-[#222222] bg-black text-[#666666]'
                }`}>
                  <span className="block">3 TRACKS</span>
                  <span className="font-bold">$25 (SAVE $5)</span>
                </div>
                <div className={`p-1.5 border text-center ${
                  favorites.length >= 5 && favorites.length < 8 
                    ? 'border-white bg-white text-black font-bold shadow-[0_0_8px_rgba(255,255,255,0.25)]' 
                    : 'border-[#222222] bg-black text-[#666666]'
                }`}>
                  <span className="block">5-TRACK EP</span>
                  <span className="font-bold">$40 (SAVE $10)</span>
                </div>
                <div className={`p-1.5 border text-center ${
                  favorites.length >= 8 
                    ? 'border-white bg-white text-black font-bold shadow-[0_0_8px_rgba(255,255,255,0.25)]' 
                    : 'border-[#222222] bg-black text-[#666666]'
                }`}>
                  <span className="block">8+ OST PACK</span>
                  <span className="font-bold">$60 (SAVE $20+)</span>
                </div>
              </div>
            </div>

            {/* Crate Items List */}
            {favorites.length === 0 ? (
              <div className="border border-[#222222] p-6 text-center bg-[#070707] mb-4">
                <ShoppingBag className="w-8 h-8 text-[#555555] mx-auto mb-2" />
                <h4 className="text-sm font-bold text-white uppercase tracking-wider mb-1">
                  YOUR CRATE IS CURRENTLY EMPTY
                </h4>
                <p className="text-xs text-[#888888] mb-3 max-w-md mx-auto">
                  Browse the master releases in the store and click <strong className="text-white">[+ ADD TO CRATE]</strong> on any track to build your custom project package.
                </p>
                <button
                  type="button"
                  onClick={() => setIsCrateOpen(false)}
                  className="border border-white bg-white text-black font-bold text-xs uppercase px-4 py-1.5 hover:bg-[#dddddd] transition-colors"
                >
                  BROWSE RELEASES
                </button>
              </div>
            ) : (
              <div className="border border-[#222222] bg-[#070707] mb-4 divide-y divide-[#1a1a1a] max-h-72 overflow-y-auto">
                {CATALOG.filter((t) => favorites.includes(t.id)).map((track) => {
                  const isThisPlaying = currentTrack?.id === track.id && isPlaying;
                  return (
                    <div
                      key={track.id}
                      className="p-2 sm:px-3 sm:py-2.5 flex items-center justify-between gap-2.5 hover:bg-[#0c0c0c] transition-colors"
                    >
                      {/* Left: Play audition button + track identity */}
                      <div className="flex items-center gap-2.5 min-w-0 flex-1">
                        <button
                          type="button"
                          onClick={() => handlePlayTrack(track)}
                          className={`w-7 h-7 border text-xs flex items-center justify-center flex-shrink-0 transition-colors ${
                            isThisPlaying
                              ? 'border-white bg-white text-black'
                              : 'border-white text-white hover:bg-white hover:text-black'
                          }`}
                          title={isThisPlaying ? "Pause" : "Play preview"}
                        >
                          {isThisPlaying ? <Pause className="w-3 h-3 fill-current" /> : <Play className="w-3 h-3 fill-current" />}
                        </button>

                        <div className="min-w-0">
                          <div className="flex items-center gap-2">
                            <span className="text-[10px] text-[#666666] font-bold">{track.catalogId}</span>
                            <span className="text-xs font-bold text-white uppercase truncate">{track.title}</span>
                          </div>
                          <div className="text-[10px] text-[#888888] flex items-center gap-1.5 mt-0.5">
                            <span className="text-white">[{track.moodPrimary}]</span>
                            <span>&bull;</span>
                            <span>{track.genre}</span>
                            <span>&bull;</span>
                            <span>{track.duration}</span>
                          </div>
                        </div>
                      </div>

                      {/* Right: Price & Remove button */}
                      <div className="flex items-center gap-2 flex-shrink-0">
                        <span className="text-xs text-white font-mono font-bold">$10.00</span>
                        <button
                          type="button"
                          onClick={() => toggleFavorite(track.id)}
                          className="border border-[#333333] hover:border-white hover:text-white p-1 text-[10px] text-[#777777] transition-colors"
                          title="Remove track from crate"
                        >
                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}

            {/* Financial Totals Card */}
            {favorites.length > 0 && (
              <div className="border border-white p-3 bg-[#0a0a0a] mb-4 space-y-1.5 text-xs">
                <div className="flex justify-between border-b border-[#222222] pb-1">
                  <span className="text-[#888888]">CRATE ITEMS:</span>
                  <span className="text-white font-bold">{favorites.length} Uncompressed WAV Masters</span>
                </div>
                <div className="flex justify-between border-b border-[#222222] pb-1">
                  <span className="text-[#888888]">CATALOG BASE PRICE:</span>
                  <span className="text-[#aaaaaa] line-through">${favorites.length * 10}.00 USD</span>
                </div>
                {shortlistPricing.savings > 0 && (
                  <div className="flex justify-between border-b border-[#222222] pb-1 text-white">
                    <span className="font-bold">BUNDLE DISCOUNT APPLIED:</span>
                    <span className="font-bold">-${shortlistPricing.savings}.00 USD ({shortlistPricing.label})</span>
                  </div>
                )}
                <div className="flex justify-between pt-0.5 text-sm">
                  <span className="font-bold text-white uppercase">TOTAL DUE (PERPETUAL SYNC):</span>
                  <span className="font-bold text-white text-base font-mono">
                    ${shortlistPricing.total}.00 USD
                  </span>
                </div>
              </div>
            )}

            {/* License Terms Summary */}
            <div className="border border-[#222222] bg-[#050505] p-2.5 mb-4 text-[10px] text-[#888888] space-y-1">
              <div>&bull; <strong className="text-white">PERPETUAL INDIE LICENSE:</strong> Non-exclusive synchronization for games, indie films, trailers, YouTube, and podcasts worldwide.</div>
              <div>&bull; <strong className="text-white">COMMERCIAL CEILING:</strong> Covers projects up to $2,000 USD gross revenue or 100,000 streams. Over $2,000 revenue requires contacting Give It All Records for a standard master extension split.</div>
              <div>&bull; <strong className="text-white">DIRECT DISPATCH:</strong> 24-bit / 48kHz WAV audio files delivered direct to your email upon checkout.</div>
            </div>

            {/* Modal Actions */}
            {favorites.length > 0 ? (
              <div className="space-y-2">
                <a
                  href={`mailto:contact@giveitallrecords.com?subject=PROJECT%20CRATE%20ORDER%20//%20${favorites.length}%20MASTERS&body=I%20would%20like%20to%20acquire%20the%20following%20project%20bundle%20(${favorites.length}%20masters%20for%20$${shortlistPricing.total}.00%20USD):%0A%0A${encodeURIComponent(
                    CATALOG.filter((t) => favorites.includes(t.id))
                      .map((t) => `${t.catalogId} - ${t.title} [${t.genre}]`)
                      .join('%0A')
                  )}%0A%0ATOTAL:%20$${shortlistPricing.total}.00%20USD%0ALICENSE:%20PERPETUAL%20NON-EXCLUSIVE%20(UP%20TO%20$2,000%20GROSS%20REVENUE)`}
                  className="w-full text-center py-2.5 bg-white text-black font-bold uppercase text-xs tracking-wider border-2 border-white hover:bg-black hover:text-white transition-all flex items-center justify-center gap-1.5 shadow-[0_0_15px_rgba(255,255,255,0.2)]"
                >
                  <Mail className="w-3.5 h-3.5" />
                  <span>ACQUIRE ENTIRE CRATE BUNDLE &bull; ${shortlistPricing.total}.00 USD</span>
                  <ArrowUpRight className="w-3.5 h-3.5 stroke-[2.5]" />
                </a>

                <div className="grid grid-cols-2 gap-2 text-xs">
                  <button
                    type="button"
                    onClick={() => {
                      setShowCrateOnly(true);
                      setIsCrateOpen(false);
                    }}
                    className="py-1.5 border border-white text-white hover:bg-white hover:text-black uppercase transition-colors"
                  >
                    FILTER CATALOG TO CRATE
                  </button>

                  <button
                    type="button"
                    onClick={() => setFavorites([])}
                    className="py-1.5 border border-[#333333] text-[#777777] hover:text-white hover:border-white uppercase transition-colors"
                  >
                    EMPTY CRATE
                  </button>
                </div>
              </div>
            ) : null}

            <div className="mt-3 text-center">
              <button
                type="button"
                onClick={() => setIsCrateOpen(false)}
                className="text-[11px] text-[#666666] hover:text-white uppercase"
              >
                [CLOSE CRATE WINDOW]
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ================================================================================== */}
      {/* 7. FLOATING CRATE HUD NOTIFICATION TOAST                                           */}
      {/* ================================================================================== */}
      {crateToast && (
        <aside 
          aria-label="Crate notification"
          className="fixed bottom-14 sm:bottom-16 right-3 sm:right-6 z-50 border-2 border-white bg-black text-white p-3 font-mono shadow-[0_0_20px_rgba(255,255,255,0.3)] max-w-sm flex items-center justify-between gap-3 animate-bounce"
        >
          <div className="text-xs">
            <span className="text-white font-bold block uppercase flex items-center gap-1">
              <ShoppingBag className="w-3.5 h-3.5" />
              <span>PROJECT CRATE:</span>
            </span>
            <p className="text-[11px] text-[#cccccc] mt-0.5">{crateToast}</p>
          </div>

          <div className="flex items-center gap-1.5 flex-shrink-0">
            <button
              type="button"
              onClick={() => {
                setCrateToast(null);
                setIsCrateOpen(true);
              }}
              className="border border-white bg-white text-black text-[10px] font-bold uppercase px-2 py-1 hover:bg-black hover:text-white transition-colors"
            >
              VIEW CRATE ↗
            </button>
            <button
              type="button"
              onClick={() => setCrateToast(null)}
              className="text-[#666666] hover:text-white p-0.5"
            >
              <X className="w-3.5 h-3.5" />
            </button>
          </div>
        </aside>
      )}
    </div>
  );
}
