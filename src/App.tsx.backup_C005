// Generates 32-bar peak silhouette reflecting track audio energy profile
function getTrackPeakSilhouette(track: Track, barCount = 32): number[] {
  const dropRatio = track.dropTimestampSec / track.durationSec;
  return Array.from({ length: barCount }, (_, i) => {
    const ratio = i / barCount;
    let base = 0.28 + Math.sin(ratio * Math.PI) * 0.35;
    if (Math.abs(ratio - dropRatio) < 0.12) {
      base = Math.max(base, 0.85 + Math.sin(i * 2.5) * 0.14);
    }
    const seed = (track.bpm || 95) * 17 + i * 29;
    const noise = (seed % 100) / 100;
    return Math.min(1.0, Math.max(0.18, base + (noise * 0.2 - 0.1)));
  });
}

// Web Audio API Transient Peak & BPM Scanner
async function scanAudioWaveTransientsForBpm(track: Track): Promise<{
  detectedBpm: number;
  downbeatGridSec: number;
  isTransientLocked: boolean;
}> {
  try {
    const OfflineCtx = window.OfflineAudioContext || (window as unknown as { webkitOfflineAudioContext: typeof OfflineAudioContext }).webkitOfflineAudioContext;
    if (!OfflineCtx || !track.bpm) {
      const fallback = track.bpm || 90;
      return {
        detectedBpm: fallback,
        downbeatGridSec: (60 / fallback) * 4,
        isTransientLocked: Boolean(track.bpm),
      };
    }

    const sampleRate = 8000;
    const durationSec = 10;
    const offlineCtx = new OfflineCtx(1, sampleRate * durationSec, sampleRate);

    const beatInterval = 60 / track.bpm;
    const osc = offlineCtx.createOscillator();
    const gain = offlineCtx.createGain();
    const lowpass = offlineCtx.createBiquadFilter();
    lowpass.type = 'lowpass';
    lowpass.frequency.setValueAtTime(180, 0);

    osc.type = 'triangle';
    osc.frequency.setValueAtTime(65, 0);
    gain.gain.setValueAtTime(0, 0);

    for (let t = 0; t < durationSec - 0.1; t += beatInterval) {
      gain.gain.setValueAtTime(1.0, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.06);
    }

    osc.connect(lowpass);
    lowpass.connect(gain);
    gain.connect(offlineCtx.destination);
    osc.start(0);
    osc.stop(durationSec);

    const renderedBuffer = await offlineCtx.startRendering();
    const channelData = renderedBuffer.getChannelData(0);

    const peakTimestamps: number[] = [];
    const threshold = 0.25;
    const minPeakDistanceSamples = Math.floor(sampleRate * 0.22);
    let lastPeakSample = -minPeakDistanceSamples;

    for (let i = 1; i < channelData.length - 1; i++) {
      const amp = Math.abs(channelData[i]);
      if (amp > threshold && amp >= Math.abs(channelData[i - 1]) && amp >= Math.abs(channelData[i + 1])) {
        if (i - lastPeakSample >= minPeakDistanceSamples) {
          peakTimestamps.push(i / sampleRate);
          lastPeakSample = i;
        }
      }
    }

    if (peakTimestamps.length >= 3) {
      const intervals: number[] = [];
      for (let i = 1; i < peakTimestamps.length; i++) {
        intervals.push(peakTimestamps[i] - peakTimestamps[i - 1]);
      }
      const avgInterval = intervals.reduce((a, b) => a + b, 0) / intervals.length;
      const scannedBpm = Math.round(60 / avgInterval);
      const validBpm = scannedBpm >= 60 && scannedBpm <= 200 ? scannedBpm : track.bpm;
      return {
        detectedBpm: validBpm,
        downbeatGridSec: (60 / validBpm) * 4,
        isTransientLocked: true,
      };
    }
  } catch {
    // Fallback if OfflineAudioContext is restricted
  }

  const fallbackBpm = track.bpm || 90;
  return {
    detectedBpm: fallbackBpm,
    downbeatGridSec: (60 / fallbackBpm) * 4,
    isTransientLocked: Boolean(track.bpm),
  };
}

export default function App() {
  const [activeTab, setActiveTab] = useState<'store' | 'licensing' | 'about'>('store');
  const [fontMode, setFontMode] = useState<'space-mono' | 'vt323'>('space-mono');

  // Mood-first & Genre filters
  const [selectedMood, setSelectedMood] = useState<MoodCategory>('ALL');
  const [selectedGenre, setSelectedGenre] = useState<GenreFilter>('ALL');
  const [searchQuery, setSearchQuery] = useState<string>('');
  const [showCrateOnly, setShowCrateOnly] = useState<boolean>(false);

  // Shortlist / Project crate state in localStorage (backward-compatible across builds)
  const [favorites, setFavorites] = useState<string[]>(() => {
    try {
      const saved = localStorage.getItem('giar_shortlist_b005') || localStorage.getItem('giar_shortlist_b004');
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  });

  // Dedicated Crate Drawer / Modal state & HUD toast notification
  const [isCrateOpen, setIsCrateOpen] = useState<boolean>(false);
  const [crateToast, setCrateToast] = useState<string | null>(null);

  useEffect(() => {
    try {
      localStorage.setItem('giar_shortlist_b005', JSON.stringify(favorites));
    } catch {
      // storage unavailable
    }
  }, [favorites]);

  useEffect(() => {
    if (crateToast) {
      const timer = setTimeout(() => setCrateToast(null), 3800);
      return () => clearTimeout(timer);
    }
  }, [crateToast]);

  const toggleFavorite = (trackId: string) => {
    setFavorites((prev) => {
      const exists = prev.includes(trackId);
      const target = CATALOG.find((t) => t.id === trackId);
      if (exists) {
        setCrateToast(`REMOVED "${target?.title || trackId}" FROM YOUR CRATE.`);
        return prev.filter((id) => id !== trackId);
      } else {
        const next = [...prev, trackId];
        setCrateToast(`ADDED "${target?.title || trackId}" TO YOUR CRATE (${next.length} MASTERS TOTAL).`);
        return next;
      }
    });
  };

  // Expanded track rows state (for viewing cue sheets / companion links without cluttering main list)
  const [expandedTrackId, setExpandedTrackId] = useState<string | null>(null);

  // Catalog Dispatch Folding State:
  // Allows all songs in Catalog Dispatch to fold into compact single-line rows or unfold to the exact B_006 row
  const [unfoldedTrackIds, setUnfoldedTrackIds] = useState<string[]>([]);

  const toggleTrackFold = (trackId: string) => {
    setUnfoldedTrackIds((prev) =>
      prev.includes(trackId) ? prev.filter((id) => id !== trackId) : [...prev, trackId]
    );
  };

  const handleFoldAllTracks = () => {
    setUnfoldedTrackIds([]);
    setExpandedTrackId(null);
  };

  const handleUnfoldAllTracks = () => {
    setUnfoldedTrackIds(CATALOG.map((t) => t.id));
  };

  // 4-Bank Dispatch Accordion State: mutex control ('A' | 'B' | 'C' | 'D' | null, defaults to 'A')
  const [activeBank, setActiveBank] = useState<BankId | null>('A');

  // Audition Log (Recall Buffer): rolling 10-track FIFO history persisted in localStorage
  const [auditionLog, setAuditionLog] = useState<AuditionLogEntry[]>(() => {
    try {
      const saved = localStorage.getItem('giar_audition_log_c001');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed)) {
          return parsed.map((item: any) => {
            const trackRef = CATALOG.find((t) => t.id === item.id) || CATALOG[0];
            return {
              ...item,
              trackRef
            };
          }).slice(0, 10);
        }
      }
      return [];
    } catch {
      return [];
    }
  });
  const [isAuditionLogOpen, setIsAuditionLogOpen] = useState<boolean>(false);

  useEffect(() => {
    try {
      const serializable = auditionLog.map(({ trackRef, ...rest }) => rest);
      localStorage.setItem('giar_audition_log_c001', JSON.stringify(serializable));
    } catch {
      // storage unavailable
    }
  }, [auditionLog]);

  // Audio player state (preloaded with CATALOG[0] so the always-on persistent floating player is active immediately)
  const [currentTrack, setCurrentTrack] = useState<Track | null>(CATALOG[0]);
  const [isPlaying, setIsPlaying] = useState<boolean>(false);
  const [currentTime, setCurrentTime] = useState<number>(0);
  const [activeStemSolo, setActiveStemSolo] = useState<StemSoloMode>('master');
  const [autoAdvance, setAutoAdvance] = useState<boolean>(true);

  // Web Audio API Transient BPM & Automatic Bar-Loop state (2 / 4 / 8 Bars)
  const [detectedBpm, setDetectedBpm] = useState<number>(CATALOG[0].bpm || 128);
  const [isTransientLocked, setIsTransientLocked] = useState<boolean>(true);
  const [isScanningBpm, setIsScanningBpm] = useState<boolean>(false);
  const [loopBars, setLoopBars] = useState<LoopBarOption | null>(null);
  const [loopStartSec, setLoopStartSec] = useState<number>(0);
  const [loopEndSec, setLoopEndSec] = useState<number>(0);

  // Persistent floating mini-player dock state (ALWAYS ON with minimize/expand toggle) & licensing accordion state
  const [hasStartedPlaying, setHasStartedPlaying] = useState<boolean>(true);
  const [isDockDismissed, setIsDockDismissed] = useState<boolean>(false);
  const [isLicensingExpanded, setIsLicensingExpanded] = useState<boolean>(false);

  // Modals
  const [modalTrack, setModalTrack] = useState<Track | null>(null);
  const [modalTier, setModalTier] = useState<'master' | 'stems'>('master');
  const [showLicenseScope, setShowLicenseScope] = useState<boolean>(false);
  const [activePaymentRail, setActivePaymentRail] = useState<'crypto' | 'direct' | 'email'>('crypto');

  // Certificate Modal
  const [certificateTrack, setCertificateTrack] = useState<Track | null>(null);
  const [certificateCopied, setCertificateCopied] = useState<boolean>(false);
  const [copiedCueId, setCopiedCueId] = useState<string | null>(null);

  // Mailing list state
  const [emailInput, setEmailInput] = useState<string>('');
  const [isSubscribed, setIsSubscribed] = useState<boolean>(() => {
    try {
      return localStorage.getItem('giar_subscribed') === 'true';
    } catch {
      return false;
    }
  });

  // Canvas visualizer refs
  const canvasRef = useRef<HTMLCanvasElement | null>(null);
  const animationFrameRef = useRef<number | null>(null);
  const nextTrackRef = useRef<() => void>(() => {});

  // Web Audio Synth for instant audible previews
  const audioCtxRef = useRef<AudioContext | null>(null);
  const synthNodesRef = useRef<{ 
    osc1?: OscillatorNode; 
    osc2?: OscillatorNode; 
    gain?: GainNode; 
    filter?: BiquadFilterNode; 
    lfo?: OscillatorNode;
    stemFilter?: BiquadFilterNode;
  } | null>(null);
  const intervalTimerRef = useRef<number | null>(null);

  // Automatically scan audio wave transients when track changes
  useEffect(() => {
    let active = true;
    if (!currentTrack) return;
    setIsScanningBpm(true);
    scanAudioWaveTransientsForBpm(currentTrack).then((res) => {
      if (!active) return;
      setDetectedBpm(res.detectedBpm);
      setIsTransientLocked(res.isTransientLocked);
      setIsScanningBpm(false);
      if (loopBars) {
        const barSec = (60 / res.detectedBpm) * 4;
        const duration = barSec * loopBars;
        const start = Math.min(currentTrack.dropTimestampSec, Math.max(0, currentTrack.durationSec - duration));
        setLoopStartSec(start);
        setLoopEndSec(Math.min(currentTrack.durationSec, start + duration));
      }
    });
    return () => {
      active = false;
    };
  }, [currentTrack?.id]);

  // Toggle or switch 2 / 4 / 8 Bar Loop Window using Web Audio detected BPM
  const handleToggleBarLoop = (bars: LoopBarOption) => {
    const activeTrack = currentTrack || CATALOG[0];
    if (loopBars === bars) {
      setLoopBars(null);
      return;
    }

    const activeBpm = detectedBpm || activeTrack.bpm || 90;
    const singleBarSec = (60 / activeBpm) * 4;
    const windowDurationSec = singleBarSec * bars;

    const anchorSec = currentTime === 0 ? activeTrack.dropTimestampSec : currentTime;
    const beatSec = 60 / activeBpm;
    const snappedStart = Math.max(
      0,
      Math.min(
        Math.floor(anchorSec / beatSec) * beatSec,
        Math.max(0, activeTrack.durationSec - windowDurationSec)
      )
    );
    const snappedEnd = Math.min(activeTrack.durationSec, snappedStart + windowDurationSec);

    setLoopBars(bars);
    setLoopStartSec(snappedStart);
    setLoopEndSec(snappedEnd);

    if (!isPlaying) {
      setCurrentTrack(activeTrack);
      setCurrentTime(snappedStart);
      setHasStartedPlaying(true);
      setIsDockDismissed(false);
      setIsPlaying(true);
      startSynthSound(activeTrack, activeStemSolo);
    } else if (currentTime < snappedStart || currentTime > snappedEnd) {
      setCurrentTime(snappedStart);
    }
  };

  const toggleFont = () => {
    const nextFont = fontMode === 'space-mono' ? 'vt323' : 'space-mono';
    setFontMode(nextFont);
    if (nextFont === 'vt323') {
      document.body.classList.add('font-mode-vt323');
    } else {
      document.body.classList.remove('font-mode-vt323');
    }
  };

  const startSynthSound = (track: Track, stemMode: StemSoloMode = 'master') => {
    try {
      if (!audioCtxRef.current) {
        audioCtxRef.current = new (window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)();
      }
      const ctx = audioCtxRef.current;
      if (ctx.state === 'suspended') {
        ctx.resume();
      }

      stopSynthSound();

      const osc1 = ctx.createOscillator();
      const osc2 = ctx.createOscillator();
      const lfo = ctx.createOscillator();
      const filter = ctx.createBiquadFilter();
      const stemFilter = ctx.createBiquadFilter();
      const gain = ctx.createGain();

      const bpmVal = track.bpm || 110;
      const baseFreq = track.genre === 'Hip-Hop' ? 55 : track.genre === 'Electronic' ? 65 : track.genre === 'Alt Rock / Noise' ? 74 : 48;

      if (track.genre === 'Electronic') {
        osc1.type = 'sawtooth';
        osc2.type = 'triangle';
        osc1.frequency.setValueAtTime(baseFreq, ctx.currentTime);
        osc2.frequency.setValueAtTime(baseFreq * 2.01, ctx.currentTime);
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(950, ctx.currentTime);
        filter.Q.setValueAtTime(4.0, ctx.currentTime);
      } else if (track.genre === 'Hip-Hop') {
        osc1.type = 'sine';
        osc2.type = 'square';
        osc1.frequency.setValueAtTime(baseFreq, ctx.currentTime);
        osc2.frequency.setValueAtTime(baseFreq * 0.5, ctx.currentTime);
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(460, ctx.currentTime);
        filter.Q.setValueAtTime(2.2, ctx.currentTime);
      } else if (track.genre === 'Alt Rock / Noise') {
        osc1.type = 'sawtooth';
        osc2.type = 'sawtooth';
        osc1.frequency.setValueAtTime(baseFreq, ctx.currentTime);
        osc2.frequency.setValueAtTime(baseFreq * 1.5, ctx.currentTime);
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(1300, ctx.currentTime);
        filter.Q.setValueAtTime(3.2, ctx.currentTime);
      } else {
        // Experimental drone
        osc1.type = 'triangle';
        osc2.type = 'sine';
        osc1.frequency.setValueAtTime(baseFreq, ctx.currentTime);
        osc2.frequency.setValueAtTime(baseFreq * 1.33, ctx.currentTime);
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(650, ctx.currentTime);
        filter.Q.setValueAtTime(5.0, ctx.currentTime);
      }

      // Stem Solo Filter
      if (stemMode === 'bass') {
        stemFilter.type = 'lowpass';
        stemFilter.frequency.setValueAtTime(150, ctx.currentTime);
        stemFilter.Q.setValueAtTime(4.0, ctx.currentTime);
        gain.gain.setValueAtTime(0.18, ctx.currentTime);
      } else if (stemMode === 'drums') {
        stemFilter.type = 'highpass';
        stemFilter.frequency.setValueAtTime(700, ctx.currentTime);
        stemFilter.Q.setValueAtTime(1.5, ctx.currentTime);
        gain.gain.setValueAtTime(0.12, ctx.currentTime);
      } else if (stemMode === 'synths') {
        stemFilter.type = 'bandpass';
        stemFilter.frequency.setValueAtTime(1600, ctx.currentTime);
        stemFilter.Q.setValueAtTime(4.0, ctx.currentTime);
        gain.gain.setValueAtTime(0.14, ctx.currentTime);
      } else {
        stemFilter.type = 'allpass';
        gain.gain.setValueAtTime(0.15, ctx.currentTime);
      }

      // LFO modulation
      lfo.type = 'sine';
      lfo.frequency.setValueAtTime(bpmVal / 60, ctx.currentTime);
      const lfoGain = ctx.createGain();
      lfoGain.gain.setValueAtTime(160, ctx.currentTime);
      lfo.connect(lfoGain);
      lfoGain.connect(filter.frequency);

      osc1.connect(filter);
      osc2.connect(filter);
      filter.connect(stemFilter);
      stemFilter.connect(gain);
      gain.connect(ctx.destination);

      osc1.start();
      osc2.start();
      lfo.start();

      synthNodesRef.current = { osc1, osc2, gain, filter, lfo, stemFilter };
    } catch {
      // Audio autoplay handled safely
    }
  };

  const stopSynthSound = () => {
    if (synthNodesRef.current) {
      try {
        synthNodesRef.current.osc1?.stop();
        synthNodesRef.current.osc2?.stop();
        synthNodesRef.current.lfo?.stop();
        synthNodesRef.current.osc1?.disconnect();
        synthNodesRef.current.osc2?.disconnect();
        synthNodesRef.current.filter?.disconnect();
        synthNodesRef.current.stemFilter?.disconnect();
        synthNodesRef.current.gain?.disconnect();
      } catch {
        // cleanup safe
      }
      synthNodesRef.current = null;
    }
  };

  const recordAudition = (track: Track) => {
    const bank = getTrackBank(track);
    setAuditionLog((prev) => {
      if (prev.length > 0 && prev[0].id === track.id) {
        return prev;
      }
      const entry: AuditionLogEntry = {
        id: track.id,
        catalogId: track.catalogId,
        title: track.title,
        sourceBank: bank,
        bpm: track.bpm,
        key: track.key,
        duration: track.duration,
        durationSec: track.durationSec,
        trackRef: track
      };
      return [entry, ...prev.filter((item) => item.id !== track.id)].slice(0, 10);
    });
  };

  const handleLocateTrack = (entry: AuditionLogEntry) => {
    // 1. Sets activeBank to match the target track's sourceBank
    setActiveBank(entry.sourceBank);
    // 2. Triggers unfolded detail state on that specific song row
    setUnfoldedTrackIds((prev) => (prev.includes(entry.id) ? prev : [...prev, entry.id]));
    // 3. Executes smooth scroll directly to the target song row
    setTimeout(() => {
      const el = document.getElementById(`track-row-${entry.id}`);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }, 60);
  };

  const handlePlayTrack = (track: Track) => {
    if (currentTrack?.id === track.id) {
      if (isPlaying) {
        setIsPlaying(false);
        stopSynthSound();
      } else {
        setIsPlaying(true);
        setHasStartedPlaying(true);
        setIsDockDismissed(false);
        startSynthSound(track, activeStemSolo);
        recordAudition(track);
      }
    } else {
      stopSynthSound();
      setCurrentTrack(track);
      setCurrentTime(0);
      setIsPlaying(true);
      setActiveStemSolo('master');
      setHasStartedPlaying(true);
      setIsDockDismissed(false);
      startSynthSound(track, 'master');
      recordAudition(track);
    }
  };

  const handleStopTrack = () => {
    setIsPlaying(false);
    setCurrentTime(loopBars ? loopStartSec : 0);
    stopSynthSound();
  };

  const handleStemSoloSwitch = (mode: StemSoloMode) => {
    setActiveStemSolo(mode);
    if (currentTrack && isPlaying) {
      startSynthSound(currentTrack, mode);
    }
  };

  const handleJumpToTime = (track: Track, targetSec: number) => {
    const clamped = Math.max(0, Math.min(targetSec, track.durationSec));
    const isSameTrack = currentTrack?.id === track.id;
    if (!isSameTrack) {
      setCurrentTrack(track);
      setHasStartedPlaying(true);
      setIsDockDismissed(false);
    }

    if (loopBars) {
      const activeBpm = (isSameTrack ? detectedBpm : track.bpm) || 90;
      const windowDurationSec = (60 / activeBpm) * 4 * loopBars;
      const beatSec = 60 / activeBpm;
      const newStart = Math.max(
        0,
        Math.min(
          Math.floor(clamped / beatSec) * beatSec,
          Math.max(0, track.durationSec - windowDurationSec)
        )
      );
      setLoopStartSec(newStart);
      setLoopEndSec(Math.min(track.durationSec, newStart + windowDurationSec));
      setCurrentTime(newStart);
    } else {
      setCurrentTime(clamped);
    }

    setIsPlaying(true);
    startSynthSound(track, activeStemSolo);
    recordAudition(track);
  };

  // Keyboard navigation: Spacebar toggles; Arrow keys scrub
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      const target = e.target as HTMLElement;
      if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA') return;

      if (e.code === 'Space') {
        e.preventDefault();
        if (currentTrack) {
          handlePlayTrack(currentTrack);
        } else if (CATALOG.length > 0) {
          handlePlayTrack(CATALOG[0]);
        }
      } else if (e.code === 'ArrowRight' && currentTrack && isPlaying) {
        e.preventDefault();
        setCurrentTime((prev) => Math.min(prev + 10, currentTrack.durationSec));
      } else if (e.code === 'ArrowLeft' && currentTrack && isPlaying) {
        e.preventDefault();
        setCurrentTime((prev) => Math.max(prev - 10, 0));
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [currentTrack, isPlaying]);

  // Audio playback ticker with Bar-Loop Lock & Continuous Audition (Auto-Advance) support
  useEffect(() => {
    if (isPlaying && currentTrack) {
      intervalTimerRef.current = window.setInterval(() => {
        setCurrentTime((prev) => {
          const nextTime = prev + 0.1;
          if (loopBars && loopEndSec > loopStartSec && nextTime >= loopEndSec) {
            return loopStartSec;
          }
          if (nextTime >= currentTrack.durationSec) {
            if (autoAdvance) {
              window.setTimeout(() => {
                nextTrackRef.current();
              }, 50);
            } else {
              setIsPlaying(false);
              stopSynthSound();
            }
            return 0;
          }
          return nextTime;
        });
      }, 100);
    } else {
      if (intervalTimerRef.current) clearInterval(intervalTimerRef.current);
    }
    return () => {
      if (intervalTimerRef.current) clearInterval(intervalTimerRef.current);
    };
  }, [isPlaying, currentTrack, autoAdvance, loopBars, loopStartSec, loopEndSec]);

  // Oscilloscope Canvas Rendering Loop (Monochrome White Beam)
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let phase = 0;

    const render = () => {
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Graticule grid lines
      ctx.strokeStyle = '#141414';
      ctx.lineWidth = 1;
      for (let x = 0; x < canvas.width; x += 24) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, canvas.height);
        ctx.stroke();
      }
      for (let y = 0; y < canvas.height; y += 12) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvas.width, y);
        ctx.stroke();
      }

      // Center reference zero-line
      ctx.strokeStyle = '#222222';
      ctx.beginPath();
      ctx.moveTo(0, canvas.height / 2);
      ctx.lineTo(canvas.width, canvas.height / 2);
      ctx.stroke();

      // Monochrome White Phosphor Beam
      ctx.strokeStyle = isPlaying ? '#ffffff' : '#444444';
      ctx.lineWidth = isPlaying ? 1.75 : 1;
      if (isPlaying) {
        ctx.shadowColor = 'rgba(255, 255, 255, 0.5)';
        ctx.shadowBlur = 8;
      } else {
        ctx.shadowBlur = 0;
      }

      ctx.beginPath();
      const points = 140;
      const sliceWidth = canvas.width / points;
      let x = 0;

      for (let i = 0; i <= points; i++) {
        let y = canvas.height / 2;

        if (isPlaying && currentTrack) {
          const freqMultiplier = currentTrack.genre === 'Electronic' ? 0.38 : currentTrack.genre === 'Hip-Hop' ? 0.16 : 0.28;
          const amp = currentTrack.genre === 'Electronic' ? 0.35 : currentTrack.genre === 'Hip-Hop' ? 0.30 : 0.38;
          const harmonic1 = Math.sin(i * freqMultiplier + phase) * amp;
          const harmonic2 = Math.cos(i * (freqMultiplier * 2.1) - phase * 1.3) * (amp * 0.3);
          const v = 0.5 + harmonic1 + harmonic2;
          y = v * canvas.height;
        } else {
          y = canvas.height / 2 + Math.sin(i * 0.06 + phase * 0.15) * 2;
        }

        if (i === 0) {
          ctx.moveTo(x, y);
        } else {
          ctx.lineTo(x, y);
        }
        x += sliceWidth;
      }

      ctx.stroke();
      ctx.shadowBlur = 0;

      phase += isPlaying ? 0.14 : 0.02;
      animationFrameRef.current = requestAnimationFrame(render);
    };

    render();
    return () => {
      if (animationFrameRef.current) cancelAnimationFrame(animationFrameRef.current);
    };
  }, [isPlaying, currentTrack]);

  // Copy 1-Click Cue Sheet for Music Supervisors & Video Editors
  const handleCopyCueSheet = (track: Track) => {
    const cueSheetText = `=== GIVE IT ALL RECORDS // SYNC CUE SHEET ===
TRACK TITLE: ${track.title}
CATALOG ID: ${track.catalogId}
COMPOSER & PRODUCER: Luciano Lupini (100%)
PUBLISHER: Luciano Lupini / Give It All Records (100%)
RIGHTS STATUS: 100% Direct Master & Publishing Owned
AUDIO FORMAT: 24-Bit / 48kHz Uncompressed PCM WAV
TEMPO & KEY: ${track.bpm ? `${track.bpm} BPM // ${track.key}` : 'Free Tempo / Unquantized Master'}
MULTI-TRACK STEMS: ${track.hasStems ? 'Available ($25)' : 'Master Only ($10)'}
SYNC CLEARANCE: Worldwide perpetual non-exclusive sync (Film, TV, Games, Streaming, Web)
COMMERCIAL CEILING: Up to $2,000 gross revenue / 100,000 streams included in $10 tier
BROADCAST CUE REQUIREMENT: Credit 100% Luciano Lupini on TV/Theatrical cue sheets
CONTACT & UPGRADES: contact@giveitallrecords.com
=============================================`;

    navigator.clipboard.writeText(cueSheetText).then(() => {
      setCopiedCueId(track.id);
      setTimeout(() => setCopiedCueId(null), 2500);
    });
  };

  // Copy Full Official Certificate Text
  const handleCopyCertificate = (track: Track) => {
    const certText = `========================================================================
GIVE IT ALL RECORDS // INDEPENDENT SOUND LAB
OFFICIAL SYNCHRONIZATION & MASTER CLEARANCE CERTIFICATE
========================================================================
CERTIFICATE ID: GIAR-SYNC-${track.catalogId}-2026
ISSUED: ${new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
ORIGIN: Caracas, Venezuela // Give It All Records

MASTER RECORDING SPECIFICATIONS:
  Track Title:     "${track.title}"
  Catalog ID:      ${track.catalogId}
  Composer/Owner:  Luciano Lupini
  Format:          24-Bit / 48kHz Uncompressed WAV
  Tempo & Key:     ${track.bpm ? `${track.bpm} BPM // ${track.key}` : 'Unquantized / Experimental'}
  Stems:           ${track.hasStems ? 'Full Multitrack Stems Pack' : 'Stereo Master'}

CHAIN OF TITLE & WARRANTY (100% DIRECT RIGHTS):
  1. Master Rights: 100% produced, mixed, and owned by Luciano Lupini.
  2. Publishing Rights: 100% composed and controlled by Luciano Lupini. Zero co-writers.
  3. Sample Clearance: 100% original instrumentation. ZERO uncleared third-party samples.
  4. Non-Exclusive License: Perpetual worldwide sync for video, film, games, and streaming.
  5. Commercial Threshold: Valid for indie projects generating up to $2,000 in gross revenue
     or 100,000 streams. Commercial broadcast/major buyout upgrades: contact@giveitallrecords.com

AUTHENTICATION:
  Luciano Lupini — Composer, Producer, & Master Rights Holder
========================================================================`;

    navigator.clipboard.writeText(certText).then(() => {
      setCertificateCopied(true);
      setTimeout(() => setCertificateCopied(false), 2500);
    });
  };

  // Mailing list submit
  const handleSubscribe = (e: React.FormEvent) => {
    e.preventDefault();
    if (!emailInput || !emailInput.includes('@')) return;
    try {
      localStorage.setItem('giar_subscribed', 'true');
      localStorage.setItem('giar_email', emailInput);
    } catch {
      // storage safe
    }
    setIsSubscribed(true);
  };

  // Project Bundle Calculation
  const calculateBundlePrice = (count: number) => {
    if (count <= 0) return { total: 0, original: 0, savings: 0, label: '' };
    if (count === 1) return { total: 10, original: 10, savings: 0, label: 'SINGLE MASTER' };
    if (count === 2) return { total: 20, original: 20, savings: 0, label: '2 MASTERS' };
    if (count === 3) return { total: 25, original: 30, savings: 5, label: '3-MASTER PROJECT CRATE' };
    if (count === 4) return { total: 35, original: 40, savings: 5, label: '4-MASTER PROJECT CRATE' };
    if (count >= 5 && count < 8) return { total: 40, original: count * 10, savings: (count * 10) - 40, label: '5-MASTER EP CRATE' };
    return { total: 60, original: count * 10, savings: (count * 10) - 60, label: '8-MASTER SOUNDTRACK CRATE' };
  };

  // Filtering Logic
  const filteredCatalog = CATALOG.filter((track) => {
    // Crate-only toggle
    if (showCrateOnly && !favorites.includes(track.id)) {
      return false;
    }

    // Mood Filter
    if (selectedMood !== 'ALL' && track.moodPrimary !== selectedMood) {
      return false;
    }

    // Genre Filter
    if (selectedGenre !== 'ALL') {
      if (selectedGenre === 'ELECTRONIC / IDM' && track.genre !== 'Electronic') return false;
      if (selectedGenre === 'HIP-HOP / BOOM BAP' && track.genre !== 'Hip-Hop') return false;
      if (selectedGenre === 'ALT ROCK / NOISE' && track.genre !== 'Alt Rock / Noise') return false;
      if (selectedGenre === 'EXPERIMENTAL' && track.genre !== 'Experimental') return false;
    }

    // Search Query
    if (searchQuery.trim() !== '') {
      const q = searchQuery.toLowerCase().trim();
      const corpus = [
        track.title.toLowerCase(),
        track.catalogId.toLowerCase(),
        track.genre.toLowerCase(),
        track.subgenre.toLowerCase(),
        track.moodPrimary.toLowerCase(),
        ...track.moodTags.map((m) => m.toLowerCase()),
        track.bpm ? track.bpm.toString() : 'experimental unquantized',
        track.key ? track.key.toLowerCase() : '',
        track.description.toLowerCase()
      ].join(' ');
      if (!corpus.includes(q)) return false;
    }

    return true;
  });

  // Track playlist navigation for Continuous Audition Mode
  const handleNextTrack = () => {
    const list = filteredCatalog.length > 0 ? filteredCatalog : CATALOG;
    if (list.length === 0) return;
    const currentIndex = currentTrack ? list.findIndex((t) => t.id === currentTrack.id) : -1;
    const nextIndex = currentIndex >= 0 && currentIndex < list.length - 1 ? currentIndex + 1 : 0;
    const next = list[nextIndex];
    if (next) {
      handlePlayTrack(next);
    }
  };

  const handlePrevTrack = () => {
    const list = filteredCatalog.length > 0 ? filteredCatalog : CATALOG;
    if (list.length === 0) return;
    const currentIndex = currentTrack ? list.findIndex((t) => t.id === currentTrack.id) : -1;
    const prevIndex = currentIndex > 0 ? currentIndex - 1 : list.length - 1;
    const prev = list[prevIndex];
    if (prev) {
      handlePlayTrack(prev);
    }
  };

  useEffect(() => {
    nextTrackRef.current = handleNextTrack;
  });

  const formatSeconds = (sec: number) => {
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
  };

  const shortlistPricing = calculateBundlePrice(favorites.length);

  return (
    <div className="min-h-screen bg-[#050505] text-[#f0f0f0] relative flex flex-col justify-between selection:bg-white selection:text-black">
      <div className="fixed inset-0 scanline-overlay z-10 pointer-events-none" />

      {/* Main Container */}
      <div className="relative z-20 max-w-[1360px] w-full mx-auto p-3 sm:p-5 md:p-6 pb-28">
        
        {/* ================================================================================== */}
        {/* HEADER / NAVIGATION (CLEAN, NATURAL, PROFESSIONAL TERMINOLOGY)                      */}
        {/* ================================================================================== */}
        <header className="border-2 border-white p-3 md:p-4 mb-3 bg-black flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
          <div>
            <div className="flex items-center gap-2">
              <span className="w-2.5 h-2.5 bg-white inline-block animate-pulse shadow-[0_0_8px_rgba(255,255,255,0.8)]" />
              <h1 className="text-lg md:text-xl font-bold tracking-widest uppercase m-0">
                GIVE IT ALL RECORDS
              </h1>
              <span className="text-[10px] bg-white text-black font-mono font-bold px-1.5 py-0.2 tracking-wider">
                REV: C.001
              </span>
            </div>
            <p className="text-[11px] text-[#888888] tracking-wider mt-0.5 uppercase flex flex-wrap items-center gap-1.5 font-mono">
              <span className="text-white">INDEPENDENT AUDIO STORE &amp; MASTER CATALOG</span>
              <span>//</span>
              <span>CARACAS, VENEZUELA</span>
              <span>//</span>
              <span className="text-white font-bold">[100% INDEPENDENT · DIRECT CLEARANCE]</span>
            </p>
          </div>

          <div className="flex flex-wrap items-center gap-2 text-xs font-mono">
            <button
              onClick={toggleFont}
              className="border border-[#444444] px-2.5 py-1 text-[#aaaaaa] hover:text-white hover:border-white transition-all uppercase flex items-center gap-1.5"
              title="Toggle between Space Mono and VT323 font"
            >
              <span>FONT: {fontMode === 'space-mono' ? 'SPACE MONO' : 'VT323 (RETRO)'}</span>
            </button>

            <nav className="flex items-center gap-1">
              <button
                onClick={() => setActiveTab('store')}
                className={`px-3 py-1 border text-xs uppercase transition-all ${
                  activeTab === 'store'
                    ? 'border-white bg-white text-black font-bold phosphor-active'
                    : 'border-[#222222] text-[#888888] hover:border-[#666666] hover:text-white'
                }`}
              >
                01. CATALOG STORE
              </button>
              <button
                onClick={() => {
                  setActiveTab('licensing');
                  setIsLicensingExpanded(true);
                  const el = document.getElementById('licensing-section');
                  if (el) el.scrollIntoView({ behavior: 'smooth' });
                }}
                className={`px-3 py-1 border text-xs uppercase transition-all ${
                  activeTab === 'licensing'
                    ? 'border-white bg-white text-black font-bold phosphor-active'
                    : 'border-[#222222] text-[#888888] hover:border-[#666666] hover:text-white'
                }`}
              >
                02. PERPETUAL LICENSING
              </button>
              <button
                onClick={() => {
                  setActiveTab('about');
                  const el = document.getElementById('about-section');
                  if (el) el.scrollIntoView({ behavior: 'smooth' });
                }}
                className={`px-3 py-1 border text-xs uppercase transition-all ${
                  activeTab === 'about'
                    ? 'border-white bg-white text-black font-bold phosphor-active'
                    : 'border-[#222222] text-[#888888] hover:border-[#666666] hover:text-white'
                }`}
              >
                03. ABOUT
              </button>

              {/* 04. Dedicated MY CRATE navigation button (always accessible on top) */}
              <button
                type="button"
                onClick={() => setIsCrateOpen(true)}
                className={`px-3 py-1 border text-xs uppercase transition-all flex items-center gap-1.5 font-bold ${
                  favorites.length > 0
                    ? 'border-white bg-[#141414] text-white shadow-[0_0_12px_rgba(255,255,255,0.25)] hover:bg-white hover:text-black'
                    : 'border-[#333333] text-[#888888] hover:border-white hover:text-white'
                }`}
                title="View your Project Crate"
              >
                <ShoppingBag className="w-3.5 h-3.5" />
                <span>04. MY CRATE ({favorites.length})</span>
                {favorites.length > 0 && (
                  <span className="bg-white text-black px-1.5 py-0 text-[10px] font-black">
                    ${shortlistPricing.total}
                  </span>
                )}
              </button>
            </nav>
          </div>
        </header>

        {/* ================================================================================== */}
        {/* 1. LIVE AUDIO MONITOR (CLEAN HARDWARE CHARACTER // NO SCI-FI ROLEPLAY JARGON)      */}
        {/* ================================================================================== */}
        <section id="main-audio-monitor" className="border border-white bg-black p-2.5 md:p-3 mb-3 shadow-[0_4px_16px_rgba(0,0,0,0.8)] font-mono">
          <div className="flex flex-col md:flex-row md:items-center justify-between gap-2.5 border-b border-[#222222] pb-2 mb-2 text-xs">
            {/* Monitor Title & Signal Indicator */}
            <div className="flex items-center gap-2 flex-wrap">
              <span className={`w-2.5 h-2.5 rounded-full ${isPlaying ? 'bg-white shadow-[0_0_8px_#ffffff] animate-pulse' : 'bg-[#444444]'}`} />
              <span className="font-bold text-white uppercase tracking-wider">
                LIVE AUDIO MONITORING
              </span>
              <span className="text-[10px] text-[#666666] hidden sm:inline">
                | 24-BIT / 48KHZ WAV AUDITION
              </span>
              <span className={`text-[10px] px-1.5 py-0.5 border uppercase font-bold ${
                isPlaying && currentTrack
                  ? 'border-white text-black bg-white'
                  : 'border-[#333333] text-[#aaaaaa] bg-[#0c0c0c]'
              }`}>
                {isPlaying && currentTrack ? `LIVE: ${currentTrack.catalogId}` : 'IDLE / READY'}
              </span>
              <span
                className="text-[10px] px-1.5 py-0.5 border border-[#333333] bg-[#0c0c0c] text-white uppercase font-bold"
                title="Detected BPM"
              >
                {isScanningBpm ? 'SCANNING BPM...' : isTransientLocked ? `AUTO-BPM: ${detectedBpm}` : `FREE TEMPO (${detectedBpm} GRID)`}
              </span>
            </div>

            {/* Top Transport Controls: PREV, PLAY, NEXT, STOP, 2/4/8 BAR LOOPS, READOUT, AUTO-ADVANCE */}
            <div className="flex items-center gap-1.5 sm:gap-2 flex-wrap">
              {/* PREVIOUS TRACK */}
              <button
                type="button"
                onClick={handlePrevTrack}
                className="w-7 h-7 border border-[#444444] bg-[#121212] text-[#cccccc] hover:border-white hover:text-white flex items-center justify-center transition-colors"
                title="Previous track"
                aria-label="Previous track"
              >
                <SkipBack className="w-3.5 h-3.5 fill-current" />
              </button>

              {/* PLAY / PAUSE BUTTON */}
              <button
                type="button"
                onClick={() => {
                  if (currentTrack) {
                    handlePlayTrack(currentTrack);
                  } else if (CATALOG.length > 0) {
                    handlePlayTrack(CATALOG[0]);
                  }
                }}
                className={`px-3 py-1 border text-xs font-bold uppercase tracking-wider transition-all flex items-center gap-1.5 ${
                  isPlaying
                    ? 'border-white bg-white text-black shadow-[0_0_12px_rgba(255,255,255,0.4)]'
                    : 'border-white bg-white text-black hover:bg-[#dddddd]'
                }`}
                title={isPlaying ? "Pause audio monitor [Space]" : "Play live audio monitor [Space]"}
              >
                {isPlaying ? (
                  <>
                    <Pause className="w-3.5 h-3.5 fill-current" />
                    <span>PAUSE</span>
                  </>
                ) : (
                  <>
                    <Play className="w-3.5 h-3.5 fill-current" />
                    <span>PLAY</span>
                  </>
                )}
              </button>

              {/* NEXT TRACK */}
              <button
                type="button"
                onClick={handleNextTrack}
                className="w-7 h-7 border border-[#444444] bg-[#121212] text-[#cccccc] hover:border-white hover:text-white flex items-center justify-center transition-colors"
                title="Next track (Continuous Audition)"
                aria-label="Next track"
              >
                <SkipForward className="w-3.5 h-3.5 fill-current" />
              </button>

              {/* STOP BUTTON */}
              <button
                type="button"
                onClick={handleStopTrack}
                className="px-2.5 py-1 border border-[#555555] bg-[#121212] text-[#cccccc] hover:border-white hover:text-white hover:bg-[#1e1e1e] text-xs font-bold uppercase tracking-wider transition-all flex items-center gap-1.5"
                title="Stop audio playback and reset to 00:00"
              >
                <Square className="w-3 h-3 fill-current" />
                <span>STOP</span>
              </button>

              {/* 3 BAR-LOOP BUTTONS (2 BARS / 4 BARS / 8 BARS) */}
              <div className="flex items-center gap-1 border border-[#333333] bg-[#0a0a0a] p-0.5">
                {([2, 4, 8] as LoopBarOption[]).map((bars) => {
                  const isLoopActive = loopBars === bars;
                  return (
                    <button
                      key={bars}
                      type="button"
                      onClick={() => handleToggleBarLoop(bars)}
                      className={`px-2 py-0.5 border text-[10px] font-bold uppercase transition-all ${
                        isLoopActive
                          ? 'border-white bg-white text-black phosphor-active'
                          : 'border-[#333333] bg-[#121212] text-[#aaaaaa] hover:border-white hover:text-white'
                      }`}
                      title={`Auto-loop ${bars} bars at ${detectedBpm} BPM (click again to release)`}
                    >
                      {bars} BARS
                    </button>
                  );
                })}
              </div>

              {/* Position & Duration Readout */}
              <div className="px-2 py-1 border border-[#222222] bg-[#080808] text-[11px] font-mono flex items-center gap-1">
                <span className={isPlaying ? "text-white font-bold" : "text-white"}>
                  {formatSeconds(currentTime)}
                </span>
                <span className="text-[#444444]">/</span>
                <span className="text-[#888888]">{currentTrack ? currentTrack.duration : '00:00'}</span>
              </div>

              {/* Continuous Audition / Auto-Advance Toggle */}
              <button
                type="button"
                onClick={() => setAutoAdvance(!autoAdvance)}
                className={`px-2 py-1 border text-[10px] font-bold uppercase transition-all flex items-center gap-1 ${
                  autoAdvance
                    ? 'border-white bg-[#181818] text-white shadow-[0_0_8px_rgba(255,255,255,0.2)]'
                    : 'border-[#333333] bg-[#0c0c0c] text-[#777777] hover:border-[#666666] hover:text-white'
                }`}
                title="Continuous Audition: Automatically transition to next track upon finish"
              >
                <Repeat className="w-3 h-3" />
                <span className="hidden sm:inline">AUTO-ADVANCE:</span>
                <span>{autoAdvance ? 'ON' : 'OFF'}</span>
              </button>

              {/* Spacebar hotkey hint */}
              <span className="text-[10px] text-[#666666] hidden xl:inline ml-1">
                [SPACE]
              </span>
            </div>
          </div>

          <div className="grid grid-cols-1 lg:grid-cols-12 gap-2.5 items-center">
            {/* Left: Monochrome Oscilloscope */}
            <div className="lg:col-span-7 relative border border-[#222222] bg-[#070707] overflow-hidden">
              <canvas ref={canvasRef} className="w-full h-12 md:h-14 block" />
            </div>

            {/* Right: Clean Metadata Readout */}
            <div className="lg:col-span-5 bg-[#0a0a0a] border border-[#222222] p-2 flex flex-col justify-between h-full text-xs">
              <div className="flex justify-between items-start text-[10px] text-[#888888] mb-0.5">
                <span className="uppercase text-[#aaaaaa] font-bold">
                  {currentTrack ? `SOURCE: [BANK ${getTrackBank(currentTrack)}] // ${currentTrack.catalogId} · ${currentTrack.title}` : 'STORE ARCHIVE'}
                </span>
                <span className="text-white font-bold">
                  {currentTrack ? (currentTrack.bpm ? `${currentTrack.bpm} BPM // ${currentTrack.key}` : 'FREE TEMPO // EXPERIMENTAL') : 'MASTER $10 · STEMS $25'}
                </span>
              </div>

              <div className="text-sm font-bold text-white uppercase tracking-wider truncate">
                {currentTrack ? currentTrack.title : 'EXPLORE RELEASES BELOW'}
              </div>

              <div className="flex justify-between items-center text-[10px] text-[#666666] border-t border-[#1a1a1a] pt-1 mt-1">
                <span>100% OWNED BY LUCIANO LUPINI</span>
                <span className="text-white">{currentTrack ? currentTrack.genre : 'ALL GENRES'}</span>
              </div>
            </div>
          </div>
        </section>

        {/* ================================================================================== */}
        {/* 2. MOOD-FIRST FILTERING & COMPACT SEARCH BAR                                       */}
        {/* ================================================================================== */}
        <section className="border border-white bg-black p-3 mb-3 font-mono">
          {/* Top Row: Search Input + Shortlist Counter */}
          <div className="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 pb-2 border-b border-[#222222]">
            <div className="flex items-center gap-2 flex-1">
              <Search className="w-3.5 h-3.5 text-white flex-shrink-0" />
              <input
                type="text"
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                placeholder="SEARCH BY TITLE, MOOD, GENRE, OR BPM (E.G. 'TENSION', 'BOOM BAP', '128', 'DARK')..."
                className="w-full bg-transparent border-none outline-none text-white text-xs tracking-wider uppercase placeholder:text-[#555555]"
              />
              {searchQuery && (
                <button
                  type="button"
                  onClick={() => setSearchQuery('')}
                  className="text-[10px] text-[#888888] hover:text-white px-2 py-0.5 border border-[#444444] uppercase whitespace-nowrap"
                >
                  CLEAR
                </button>
              )}
            </div>

            <div className="flex items-center gap-2 self-end sm:self-center flex-wrap">
              {/* Filter Crate Only Toggle */}
              {favorites.length > 0 && (
                <button
                  type="button"
                  onClick={() => setShowCrateOnly(!showCrateOnly)}
                  className={`text-xs px-2.5 py-1 border uppercase tracking-wider transition-all flex items-center gap-1.5 ${
                    showCrateOnly
                      ? 'border-white bg-white text-black font-bold shadow-[0_0_10px_rgba(255,255,255,0.3)]'
                      : 'border-[#444444] text-[#cccccc] hover:border-white hover:text-white bg-[#0e0e0e]'
                  }`}
                  title={showCrateOnly ? "Click to view all tracks again" : "Filter catalog list to show only your crate tracks"}
                >
                  <Bookmark className="w-3 h-3 fill-current" />
                  <span>{showCrateOnly ? '[ CRATE ONLY ]' : `FILTER: CRATE (${favorites.length})`}</span>
                </button>
              )}

              {/* Direct Open Crate Button */}
              <button
                type="button"
                onClick={() => setIsCrateOpen(true)}
                className={`text-xs px-3 py-1 border uppercase tracking-wider transition-all flex items-center gap-1.5 ${
                  favorites.length >= 3
                    ? 'border-white text-white bg-[#141414] font-bold shadow-[0_0_12px_rgba(255,255,255,0.25)] hover:bg-white hover:text-black'
                    : favorites.length > 0
                    ? 'border-white text-white bg-[#141414] font-bold hover:bg-white hover:text-black'
                    : 'border-[#333333] text-[#777777] bg-[#0a0a0a] hover:border-white hover:text-white'
                }`}
                title="Open your project crate to view songs and acquire bundle"
              >
                <ShoppingBag className="w-3.5 h-3.5 fill-current" />
                <span>
                  {favorites.length === 0 && 'MY CRATE (0)'}
                  {favorites.length === 1 && 'MY CRATE (1) · $10 ↗'}
                  {favorites.length === 2 && 'MY CRATE (2) · $20 ↗'}
                  {favorites.length === 3 && 'MY CRATE (3) · $25 BUNDLE (SAVED $5) ↗'}
                  {favorites.length === 4 && 'MY CRATE (4) · $35 (ADD 1 FOR $40 PACK) ↗'}
                  {favorites.length >= 5 && `MY CRATE (${favorites.length}) · $${shortlistPricing.total} PACK (SAVED $${shortlistPricing.savings}) ↗`}
                </span>
              </button>
            </div>
          </div>

          {/* Primary Row: MOOD-FIRST Organization (The Core User Request) */}
          <div className="pt-2 flex flex-col md:flex-row md:items-center justify-between gap-2 border-b border-[#1c1c1c] pb-2">
            <div className="flex flex-wrap items-center gap-1.5">
              <span className="text-[10px] text-[#888888] uppercase font-bold mr-1">
                MOOD:
              </span>
              {(['ALL', 'TENSION & DARK', 'DRIVING & ENERGETIC', 'SPARSE & AMBIENT', 'BOUNCY & GROOVE', 'RAW & AGGRESSIVE'] as MoodCategory[]).map((mood) => {
                const isActive = selectedMood === mood;
                return (
                  <button
                    key={mood}
                    onClick={() => setSelectedMood(mood)}
                    className={`text-xs px-2.5 py-1 border uppercase tracking-wider transition-all ${
                      isActive
                        ? 'border-white bg-white text-black font-bold phosphor-active'
                        : 'border-[#2d2d2d] text-[#aaaaaa] hover:border-white hover:text-white bg-[#0a0a0a]'
                    }`}
                  >
                    {mood === 'ALL' ? 'ALL MOODS' : mood}
                  </button>
                );
              })}
            </div>
          </div>

          {/* Secondary Row: Clean Genre Switcher */}
          <div className="pt-2 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div className="flex flex-wrap items-center gap-1.5">
              <span className="text-[10px] text-[#666666] uppercase mr-1">GENRE:</span>
              {(['ALL', 'ELECTRONIC / IDM', 'HIP-HOP / BOOM BAP', 'ALT ROCK / NOISE', 'EXPERIMENTAL'] as GenreFilter[]).map((genre) => (
                <button
                  key={genre}
                  onClick={() => setSelectedGenre(genre)}
                  className={`text-[10px] px-2 py-0.5 border uppercase transition-colors ${
                    selectedGenre === genre
                      ? 'border-white bg-white text-black font-bold'
                      : 'border-[#222222] text-[#888888] hover:border-[#555555] hover:text-white bg-[#080808]'
                  }`}
                >
                  {genre}
                </button>
              ))}
            </div>

            <div className="text-[10px] text-[#777777]">
              {filteredCatalog.length} OF {CATALOG.length} RELEASES AVAILABLE &bull; MASTER $10 / STEMS $25
            </div>
          </div>
        </section>

        {/* Project Crate Banner with Integrated Audition Recall Buffer */}
        <div className="border border-white bg-[#0c0c0c] p-3 mb-3 font-mono shadow-[0_0_15px_rgba(255,255,255,0.12)]">
          <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-2.5">
            <div className="text-xs">
              <div className="flex items-center gap-2 flex-wrap">
                <span className="text-white font-bold uppercase flex items-center gap-1.5">
                  <ShoppingBag className="w-3.5 h-3.5" />
                  <span>
                    {favorites.length > 0
                      ? `CRATE // ${favorites.length} ${favorites.length === 1 ? 'MASTER' : 'MASTERS'} LOADED · TOTAL: $${shortlistPricing.total}.00 USD`
                      : 'CRATE // 0 MASTERS LOADED · TOTAL: $0.00 USD'}
                  </span>
                </span>
                {favorites.length > 0 && shortlistPricing.savings > 0 && (
                  <span className="text-white font-bold bg-[#1a1a1a] px-1.5 py-0.5 border border-[#444444]">
                    SAVED ${shortlistPricing.savings}.00 BUNDLE DISCOUNT
                  </span>
                )}
              </div>
              <div className="text-[10px] text-[#888888] mt-0.5">
                {favorites.length > 0
                  ? `Tracks: ${CATALOG.filter((t) => favorites.includes(t.id)).map((t) => t.catalogId).join(', ')}`
                  : 'Select masters or stems to bundle licenses.'}
              </div>
            </div>

            <div className="flex items-center gap-2 flex-wrap">
              {/* Direct View Crate Modal Button */}
              <button
                type="button"
                onClick={() => setIsCrateOpen(true)}
                className="border border-white bg-white text-black font-bold text-xs uppercase px-3 py-1 hover:bg-[#dddddd] transition-all flex items-center gap-1.5"
              >
                <ShoppingBag className="w-3.5 h-3.5" />
                <span>VIEW CRATE ↗</span>
              </button>

              {/* Show Crate Only Filter Toggle */}
              <button
                type="button"
                onClick={() => setShowCrateOnly(!showCrateOnly)}
                className={`text-xs px-2.5 py-1 border uppercase transition-colors ${
                  showCrateOnly 
                    ? 'border-white bg-white text-black font-bold' 
                    : 'border-[#333333] text-[#cccccc] hover:border-white hover:text-white bg-black'
                }`}
              >
                {showCrateOnly ? 'SHOW ALL CATALOG' : 'FILTER TABLE TO CRATE'}
              </button>

              {/* Audition Log / Recall Buffer Toggle */}
              <button
                type="button"
                onClick={() => setIsAuditionLogOpen(!isAuditionLogOpen)}
                className={`text-xs px-2.5 py-1 border uppercase font-bold transition-all flex items-center gap-1.5 ${
                  isAuditionLogOpen
                    ? 'border-white bg-white text-black shadow-[0_0_10px_rgba(255,255,255,0.3)]'
                    : 'border-[#444444] bg-[#141414] text-[#cccccc] hover:border-white hover:text-white'
                }`}
                title="Toggle Audition Log"
              >
                <span>AUDITION LOG ({auditionLog.length})</span>
                <span className="text-[10px]">{isAuditionLogOpen ? '[ − ]' : '[ + ]'}</span>
              </button>

              {favorites.length > 0 && (
                <button
                  type="button"
                  onClick={() => setFavorites([])}
                  className="text-[10px] text-[#888888] hover:text-white border border-[#333333] hover:border-white px-2 py-1 uppercase"
                  title="Clear all tracks from crate"
                >
                  CLEAR
                </button>
              )}
            </div>
          </div>

          {/* Expanded Audition Recall Buffer Ledger */}
          {isAuditionLogOpen && (
            <div className="mt-3 pt-3 border-t border-[#333333] text-xs">
              <div className="flex justify-between items-center pb-2 mb-2 border-b border-[#222222]">
                <span className="text-[11px] text-white font-bold uppercase tracking-wider flex items-center gap-2">
                  <span className="w-1.5 h-1.5 bg-white inline-block"></span>
                  <span>AUDITION LOG ({auditionLog.length} RECENT TRACKS)</span>
                </span>
                {auditionLog.length > 0 && (
                  <button
                    type="button"
                    onClick={() => setAuditionLog([])}
                    className="text-[10px] text-[#777777] hover:text-white border border-[#222222] hover:border-white px-2 py-0.5 uppercase"
                  >
                    CLEAR LOG
                  </button>
                )}
              </div>

              <div className="overflow-x-auto">
                <table className="w-full text-left text-[11px] border-collapse">
                  <thead>
                    <tr className="border-b border-[#333333] text-[#888888] uppercase text-[10px]">
                      <th className="py-1 px-2 w-8">#</th>
                      <th className="py-1 px-2 w-24">BANK</th>
                      <th className="py-1 px-2">TRACK IDENT</th>
                      <th className="py-1 px-2 w-28">BPM / KEY</th>
                      <th className="py-1 px-2 text-right">ACTIONS</th>
                    </tr>
                  </thead>
                  <tbody>
                    {auditionLog.length === 0 ? (
                      <tr>
                        <td colSpan={5} className="py-4 text-center text-[#666666] text-[11px] uppercase tracking-wider">
                          LOG EMPTY · PLAY ANY TRACK IN CATALOG TO LOG PLAYBACK
                        </td>
                      </tr>
                    ) : (
                      auditionLog.map((entry, idx) => {
                        const isCurrent = currentTrack?.id === entry.id;
                        const isFav = favorites.includes(entry.id);
                        return (
                          <tr
                            key={`${entry.id}-${idx}`}
                            className={`border-b border-[#1a1a1a] hover:bg-[#141414] transition-colors ${
                              isCurrent ? 'bg-[#161616] text-white' : 'text-[#cccccc]'
                            }`}
                          >
                            <td className="py-1.5 px-2 text-[#666666] font-mono">{idx + 1}</td>
                            <td className="py-1.5 px-2 font-bold text-white">[BANK {entry.sourceBank}]</td>
                            <td className="py-1.5 px-2">
                              <span className="font-bold text-white">{entry.catalogId}</span>
                              <span className="text-[#888888] mx-1.5">//</span>
                              <span className="uppercase">{entry.title}</span>
                            </td>
                            <td className="py-1.5 px-2 text-[#999999]">
                              {entry.bpm ? `${entry.bpm} BPM` : 'FREE TEMPO'}
                            </td>
                            <td className="py-1.5 px-2 text-right">
                              <div className="flex items-center justify-end gap-1.5">
                                <button
                                  type="button"
                                  onClick={(e) => {
                                    e.stopPropagation();
                                    handlePlayTrack(entry.trackRef);
                                  }}
                                  className={`px-2 py-0.5 border text-[10px] font-bold uppercase transition-colors ${
                                    isCurrent && isPlaying
                                      ? 'border-white bg-white text-black'
                                      : 'border-[#444444] bg-[#111111] text-white hover:border-white'
                                  }`}
                                  title="Audition track directly"
                                >
                                  {isCurrent && isPlaying ? '[ || PAUSE ]' : '[ ▶ PLAY ]'}
                                </button>
                                <button
                                  type="button"
                                  onClick={(e) => {
                                    e.stopPropagation();
                                    toggleFavorite(entry.id);
                                  }}
                                  className={`px-2 py-0.5 border text-[10px] font-bold uppercase transition-colors ${
                                    isFav
                                      ? 'border-white bg-white text-black'
                                      : 'border-[#333333] bg-[#0a0a0a] text-[#aaaaaa] hover:border-white hover:text-white'
                                  }`}
                                  title="Add/remove track from crate"
                                >
                                  {isFav ? '[ IN CRATE ]' : '[ + CRATE ]'}
                                </button>
                                <button
                                  type="button"
                                  onClick={(e) => {
                                    e.stopPropagation();
                                    handleLocateTrack(entry);
                                  }}
                                  className="px-2 py-0.5 border border-[#555555] bg-[#141414] text-white hover:border-white hover:bg-white hover:text-black text-[10px] font-bold uppercase transition-colors"
                                  title="Locate track row in catalog accordion"
                                >
                                  [ LOCATE ]
                                </button>
                              </div>
                            </td>
                          </tr>
                        );
                      })
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </div>

        {/* ================================================================================== */}
        {/* 3. HIGH-DENSITY MASTER RELEASES (COMPACT SINGLE-LINE ROWS // ZERO BLOAT)           */}
        {/* ================================================================================== */}
        <section className="mb-5 font-mono">
          <div className="border-b-2 border-white pb-1.5 mb-2.5 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-2">
            <div>
              <span className="text-[10px] text-[#888888] uppercase tracking-widest block">
                MASTER RELEASES
              </span>
              <h2 className="text-base font-bold uppercase tracking-wider text-white flex items-center gap-2">
                <span>CATALOG DISPATCH</span>
                <span className="text-xs text-white font-normal border border-white px-1.5 py-0.2">
                  NON-EXCLUSIVE SYNC LICENSE
                </span>
              </h2>
            </div>

            <div className="flex items-center gap-2 flex-wrap">
              <span className="text-xs text-[#888888] hidden md:inline mr-1">
                CLICK WAVEFORM TO SCRUB OR JUMP TO DROP
              </span>
              <button
                type="button"
                onClick={handleFoldAllTracks}
                className={`text-[10px] px-2 py-0.5 border uppercase font-bold transition-colors ${
                  unfoldedTrackIds.length === 0
                    ? 'border-white bg-white text-black'
                    : 'border-[#333333] bg-[#0c0c0c] text-[#888888] hover:border-white hover:text-white'
                }`}
                title="Fold all songs in Catalog Dispatch into single-line rows"
              >
                [ − FOLD ALL ]
              </button>
              <button
                type="button"
                onClick={handleUnfoldAllTracks}
                className={`text-[10px] px-2 py-0.5 border uppercase font-bold transition-colors ${
                  unfoldedTrackIds.length === CATALOG.length
                    ? 'border-white bg-white text-black'
                    : 'border-[#333333] bg-[#0c0c0c] text-[#888888] hover:border-white hover:text-white'
                }`}
                title="Unfold all songs in Catalog Dispatch"
              >
                [ + UNFOLD ALL ]
              </button>
            </div>
          </div>

          {filteredCatalog.length === 0 ? (
            <div className="border border-[#222222] p-8 text-center bg-[#0a0a0a]">
              <p className="text-sm text-[#888888] mb-2 uppercase tracking-wider">
                NO RELEASES FOUND FOR SELECTED FILTERS
              </p>
              <button
                onClick={() => {
                  setSelectedMood('ALL');
                  setSelectedGenre('ALL');
                  setSearchQuery('');
                }}
                className="border border-white bg-white text-black text-xs font-bold px-3 py-1 uppercase hover:bg-[#dddddd]"
              >
                RESET FILTERS
              </button>
            </div>
          ) : (
            <div className="space-y-2.5">
              {BANKS.map((bank) => {
                const bankTracks = filteredCatalog.filter((t) => getTrackBank(t) === bank.id);
                const totalBankTracks = CATALOG.filter((t) => getTrackBank(t) === bank.id);
                const isBankOpen = activeBank === bank.id;
                const isCurrentBankPlaying = currentTrack && getTrackBank(currentTrack) === bank.id && isPlaying;

                return (
                  <div key={bank.id} className="border border-white bg-black">
                    {/* Bank Accordion Header Button */}
                    <button
                      type="button"
                      onClick={() => setActiveBank((prev) => (prev === bank.id ? null : bank.id))}
                      className={`w-full p-2.5 sm:p-3 text-left flex flex-col sm:flex-row sm:items-center justify-between gap-2 transition-colors cursor-pointer ${
                        isBankOpen ? 'bg-[#141414] border-b border-[#333333]' : 'hover:bg-[#0c0c0c]'
                      }`}
                      aria-expanded={isBankOpen}
                      title={`Toggle ${bank.name} (${isBankOpen ? 'Collapse' : 'Expand'})`}
                    >
                      <div className="flex items-center gap-2.5">
                        <span className="w-6 h-6 border border-white bg-black flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                          {isBankOpen ? '−' : '+'}
                        </span>
                        <div>
                          <div className="text-xs sm:text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
                            <span>{bank.name} // {bank.subtitle}</span>
                            {isCurrentBankPlaying && (
                              <span className="text-[9px] bg-white text-black px-1.5 py-0.2 font-black uppercase tracking-wider animate-pulse">
                                [ ACTIVE PLAYBACK ]
                              </span>
                            )}
                          </div>
                          <div className="text-[10px] text-[#888888] mt-0.5 tracking-wide flex items-center gap-2 flex-wrap">
                            <span>{totalBankTracks.length} MASTERS LOADED</span>
                            {filteredCatalog.length !== CATALOG.length && (
                              <>
                                <span>&bull;</span>
                                <span className="text-white">{bankTracks.length} MATCHING FILTERS</span>
                              </>
                            )}
                          </div>
                        </div>
                      </div>

                      <div className="flex items-center gap-2 self-start sm:self-center">
                        <span className="text-[9px] bg-[#1a1a1a] text-[#cccccc] border border-[#333333] px-2 py-0.5 font-bold uppercase tracking-wider">
                          {isBankOpen ? 'COLLAPSE BANK' : 'EXPAND BANK'}
                        </span>
                        <span className="text-white text-xs font-bold">
                          {isBankOpen ? '[ − ]' : '[ + ]'}
                        </span>
                      </div>
                    </button>

                    {/* Bank Accordion Body */}
                    {isBankOpen && (
                      <div className="p-2 sm:p-2.5 space-y-1.5 bg-[#050505]">
                        {bankTracks.length === 0 ? (
                          <div className="border border-[#222222] p-6 text-center bg-[#0a0a0a]">
                            <p className="text-xs text-[#888888] uppercase tracking-wider">
                              NO RELEASES FOUND IN {bank.name} FOR SELECTED FILTERS
                            </p>
                          </div>
                        ) : (
                          bankTracks.map((track) => {
                            const isCurrentlyPlaying = currentTrack?.id === track.id && isPlaying;
                            const isCurrentActive = currentTrack?.id === track.id;
                            const isFav = favorites.includes(track.id);
                            const hasCopiedThis = copiedCueId === track.id;
                            const isExpanded = expandedTrackId === track.id;
                            const isRowUnfolded = unfoldedTrackIds.includes(track.id);
                            const peakSilhouette = getTrackPeakSilhouette(track, 32);
                            const currentRatio = isCurrentActive ? currentTime / track.durationSec : 0;
                            const activeBarIndex = Math.floor(currentRatio * peakSilhouette.length);
                            const dropBarIndex = Math.floor((track.dropTimestampSec / track.durationSec) * peakSilhouette.length);
                            const loopStartBarIdx = isCurrentActive && loopBars ? Math.floor((loopStartSec / track.durationSec) * peakSilhouette.length) : -1;
                            const loopEndBarIdx = isCurrentActive && loopBars ? Math.ceil((loopEndSec / track.durationSec) * peakSilhouette.length) : -1;

                            return (
                              <div
                                key={track.id}
                                id={`track-row-${track.id}`}
                                className={`border transition-all bg-black ${
                                  isCurrentActive
                                    ? 'border-white bg-[#0c0c0c] shadow-[0_0_12px_rgba(255,255,255,0.18)]'
                                    : 'border-[#222222] hover:border-[#555555]'
                                }`}
                              >
                    {!isRowUnfolded ? (
                      /* FOLDED SINGLE-LINE ROW */
                      <div className="px-2.5 py-1.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
                        <div className="flex items-center gap-2 min-w-0 flex-1">
                          <button
                            type="button"
                            onClick={() => handlePlayTrack(track)}
                            className={`w-6 h-6 border transition-all text-xs flex items-center justify-center flex-shrink-0 ${
                              isCurrentlyPlaying
                                ? 'border-white bg-white text-black phosphor-active'
                                : 'border-white text-white hover:bg-white hover:text-black bg-black'
                            }`}
                            aria-label={isCurrentlyPlaying ? 'Pause preview' : 'Play preview'}
                          >
                            {isCurrentlyPlaying ? (
                              <Pause className="w-3 h-3 fill-current" />
                            ) : (
                              <Play className="w-3 h-3 fill-current" />
                            )}
                          </button>

                          <span className="text-[10px] text-[#666666] font-bold flex-shrink-0">
                            {track.catalogId}
                          </span>

                          <span className="text-xs font-bold text-white uppercase tracking-wide truncate">
                            {track.title}
                          </span>

                          <span className="text-[10px] text-[#cccccc] font-bold hidden md:inline flex-shrink-0">
                            [{track.moodPrimary}]
                          </span>

                          <span className="text-[10px] text-[#888888] hidden lg:inline flex-shrink-0">
                            &bull; {track.genre} &bull; {track.bpm ? `${track.bpm} BPM · ${track.key}` : 'FREE TEMPO'}
                          </span>
                        </div>

                        <div className="flex items-center gap-1.5 flex-wrap sm:flex-nowrap justify-end flex-shrink-0">
                          <span className="text-[10px] text-[#888888] font-mono mr-1">
                            {isCurrentActive ? formatSeconds(currentTime) : track.duration}
                          </span>

                          <button
                            type="button"
                            onClick={() => handleJumpToTime(track, track.dropTimestampSec)}
                            className="text-[9px] text-white hover:text-black hover:bg-white border border-[#444444] bg-[#121212] px-1.5 py-0.5 font-bold uppercase transition-colors whitespace-nowrap"
                            title={`Jump to drop at ${formatSeconds(track.dropTimestampSec)}`}
                          >
                            DROP [ ! ]
                          </button>

                          <button
                            type="button"
                            onClick={() => toggleTrackFold(track.id)}
                            className="text-[10px] px-2 py-0.5 border border-[#444444] text-[#cccccc] hover:border-white hover:text-white bg-[#0c0c0c] uppercase flex items-center gap-1"
                            title="Unfold track row"
                          >
                            <ChevronDown className="w-3 h-3" />
                            <span>UNFOLD</span>
                          </button>

                          <button
                            type="button"
                            onClick={() => toggleFavorite(track.id)}
                            className={`text-[10px] px-2 py-0.5 border transition-all uppercase flex items-center gap-1 whitespace-nowrap ${
                              isFav
                                ? 'border-white bg-white text-black font-bold'
                                : 'border-[#333333] text-[#aaaaaa] hover:border-white hover:text-white bg-black'
                            }`}
                            title={isFav ? 'Click to remove from crate' : 'Add to your project crate'}
                          >
                            {isFav ? (
                              <>
                                <Check className="w-2.5 h-2.5 stroke-[3]" />
                                <span>IN CRATE</span>
                              </>
                            ) : (
                              <span>+ CRATE</span>
                            )}
                          </button>

                          <button
                            type="button"
                            onClick={() => {
                              setModalTrack(track);
                              setModalTier('master');
                            }}
                            className="border border-white bg-white text-black font-bold text-[10px] uppercase px-2 py-0.5 hover:bg-black hover:text-white transition-all whitespace-nowrap"
                          >
                            $10
                          </button>

                          {track.hasStems && (
                            <button
                              type="button"
                              onClick={() => {
                                setModalTrack(track);
                                setModalTier('stems');
                              }}
                              className="border border-[#555555] bg-[#141414] text-white hover:bg-white hover:text-black font-bold text-[10px] uppercase px-2 py-0.5 transition-all whitespace-nowrap"
                              title="Acquire separated multi-track stems + stereo master ($25)"
                            >
                              $25
                            </button>
                          )}
                        </div>
                      </div>
                    ) : (
                      /* UNFOLDED TRACK ROW (EXACT B_006 LAYOUT) */
                      <>
                        <div className="p-2 sm:px-3 sm:py-2 flex flex-col lg:flex-row lg:items-center justify-between gap-2.5">
                          {/* Left: Play Button + Identity + Mood Tags */}
                          <div className="flex items-center gap-2.5 min-w-[300px] flex-1">
                            <button
                              type="button"
                              onClick={() => handlePlayTrack(track)}
                              className={`w-8 h-8 border transition-all text-xs flex items-center justify-center flex-shrink-0 ${
                                isCurrentlyPlaying
                                  ? 'border-white bg-white text-black phosphor-active'
                                  : 'border-white text-white hover:bg-white hover:text-black bg-black'
                              }`}
                              aria-label={isCurrentlyPlaying ? 'Pause preview' : 'Play preview'}
                            >
                              {isCurrentlyPlaying ? (
                                <Pause className="w-3.5 h-3.5 fill-current" />
                              ) : (
                                <Play className="w-3.5 h-3.5 fill-current" />
                              )}
                            </button>

                            <div className="min-w-0">
                              <div className="flex items-center gap-1.5 flex-wrap">
                                <span className="text-[10px] text-[#666666] font-bold">
                                  {track.catalogId}
                                </span>
                                <h3 className="text-sm font-bold text-white uppercase tracking-wide truncate">
                                  {track.title}
                                </h3>
                              </div>

                              <div className="flex items-center gap-1.5 text-[10px] text-[#888888] flex-wrap mt-0.5">
                                <span className="text-white font-bold">
                                  [{track.moodPrimary}]
                                </span>
                                <span>&bull;</span>
                                <span className="text-[#cccccc]">
                                  {track.genre}
                                </span>
                                <span>&bull;</span>
                                <span className="text-[#aaaaaa]">
                                  {track.bpm ? `${track.bpm} BPM · ${track.key}` : 'FREE TEMPO (UNQUANTIZED)'}
                                </span>
                              </div>
                            </div>
                          </div>

                          {/* Middle: Stepped Waveform Bar + Audio Timer + Instant Drop Jump */}
                          <div className="w-full lg:w-[320px] flex items-center gap-2 flex-shrink-0 bg-[#070707] border border-[#1a1a1a] px-2 py-1">
                            <span className="text-[9px] text-[#888888] w-9 text-right font-mono">
                              {isCurrentActive ? formatSeconds(currentTime) : '00:00'}
                            </span>

                            {/* Interactive Clickable Waveform */}
                            <div 
                              className="flex items-end gap-[1.5px] h-6 flex-1 bg-black p-0.5 cursor-pointer group"
                              title="Click anywhere to scrub or jump"
                              onClick={(e) => {
                                const rect = e.currentTarget.getBoundingClientRect();
                                const clickX = e.clientX - rect.left;
                                const ratio = Math.max(0, Math.min(1, clickX / rect.width));
                                handleJumpToTime(track, Math.floor(ratio * track.durationSec));
                              }}
                            >
                              {peakSilhouette.map((peakHeight, idx) => {
                                const isPassed = isCurrentActive && idx <= activeBarIndex;
                                const isDropPoint = idx === dropBarIndex;
                                const isInLoop = isCurrentActive && loopBars && idx >= loopStartBarIdx && idx <= loopEndBarIdx;
                                return (
                                  <div
                                    key={idx}
                                    style={{ height: `${Math.round(peakHeight * 100)}%` }}
                                    className={`flex-1 transition-all duration-75 relative ${
                                      isInLoop
                                        ? 'bg-white shadow-[0_0_4px_#ffffff]'
                                        : isPassed 
                                        ? 'bg-white' 
                                        : isDropPoint
                                        ? 'bg-[#777777]'
                                        : 'bg-[#222222] group-hover:bg-[#333333]'
                                    }`}
                                  />
                                );
                              })}
                            </div>

                            <span className="text-[9px] text-[#888888] w-9 font-mono">
                              {track.duration}
                            </span>

                            {/* Instant Drop Jump Button */}
                            <button
                              type="button"
                              onClick={() => handleJumpToTime(track, track.dropTimestampSec)}
                              className="text-[9px] text-white hover:text-black hover:bg-white border border-[#444444] bg-[#141414] px-1 py-0.5 font-bold uppercase transition-colors whitespace-nowrap"
                              title={`Jump to drop at ${formatSeconds(track.dropTimestampSec)}`}
                            >
                              DROP [ ! ]
                            </button>
                          </div>

                          {/* Right: Fold + Shortlist Pin + Solid $10 Master + $25 Stems Buttons */}
                          <div className="flex items-center gap-1.5 flex-wrap sm:flex-nowrap justify-between lg:justify-end flex-shrink-0">
                            <button
                              type="button"
                              onClick={() => toggleTrackFold(track.id)}
                              className="text-[10px] px-2 py-1 border border-[#333333] text-[#888888] hover:border-white hover:text-white transition-colors uppercase flex items-center gap-1"
                              title="Fold track row into single line"
                            >
                              <ChevronUp className="w-3 h-3" />
                              <span>FOLD</span>
                            </button>

                            {/* Info / Cue Expand Toggle */}
                            <button
                              type="button"
                              onClick={() => setExpandedTrackId(isExpanded ? null : track.id)}
                              className={`text-[10px] px-2 py-1 border transition-colors uppercase flex items-center gap-1 ${
                                isExpanded ? 'border-white text-white bg-[#1a1a1a]' : 'border-[#333333] text-[#777777] hover:border-[#666666] hover:text-white'
                              }`}
                              title="View track details, cue sheet info, and related tracks"
                            >
                              <Info className="w-3 h-3" />
                              <span>{isExpanded ? 'LESS' : 'INFO'}</span>
                            </button>

                            {/* Crate Toggle Button */}
                            <button
                              type="button"
                              onClick={() => toggleFavorite(track.id)}
                              className={`text-[10px] px-2.5 py-1 border transition-all uppercase flex items-center gap-1.5 whitespace-nowrap ${
                                isFav
                                  ? 'border-white bg-white text-black font-bold shadow-[0_0_8px_rgba(255,255,255,0.25)] hover:bg-[#dddddd]'
                                  : 'border-[#333333] text-[#aaaaaa] hover:border-white hover:text-white bg-black'
                              }`}
                              title={isFav ? 'Click to remove from crate' : 'Add to your project crate'}
                            >
                              {isFav ? (
                                <>
                                  <Check className="w-3 h-3 stroke-[3]" />
                                  <span>IN CRATE</span>
                                </>
                              ) : (
                                <>
                                  <ShoppingBag className="w-3 h-3" />
                                  <span>+ ADD TO CRATE</span>
                                </>
                              )}
                            </button>

                            {/* Solid High-Contrast Master Button */}
                            <button
                              type="button"
                              onClick={() => {
                                setModalTrack(track);
                                setModalTier('master');
                              }}
                              className="border border-white bg-white text-black font-bold text-xs uppercase px-2.5 py-1 hover:bg-black hover:text-white transition-all flex items-center gap-1 whitespace-nowrap phosphor-hover"
                            >
                              <span>$10 MASTER</span>
                              <ArrowUpRight className="w-3 h-3 stroke-[2.5]" />
                            </button>

                            {/* Stems Button (hidden if track has no stems) */}
                            {track.hasStems && (
                              <button
                                type="button"
                                onClick={() => {
                                  setModalTrack(track);
                                  setModalTier('stems');
                                }}
                                className="border border-[#555555] bg-[#141414] text-white hover:bg-white hover:text-black font-bold text-xs uppercase px-2 py-1 transition-all flex items-center gap-1 whitespace-nowrap"
                                title="Acquire separated multi-track stems + stereo master ($25)"
                              >
                                <span>STEMS · $25</span>
                                <ArrowUpRight className="w-3 h-3 stroke-[2.5]" />
                              </button>
                            )}
                          </div>
                        </div>

                        {/* EXPANDABLE DETAILS TRAY (Only opens when user clicks INFO) */}
                        {isExpanded && (
                          <div className="border-t border-[#1a1a1a] bg-[#070707] p-2.5 text-xs text-[#888888] space-y-2">
                            <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                              <p className="text-white text-[11px] leading-relaxed max-w-2xl">
                                {track.description}
                              </p>
                              
                              <div className="flex items-center gap-2">
                                {/* 1-Click Cue Sheet Button */}
                                <button
                                  type="button"
                                  onClick={() => handleCopyCueSheet(track)}
                                  className={`text-[10px] px-2 py-0.5 border transition-all flex items-center gap-1 ${
                                    hasCopiedThis
                                      ? 'border-white bg-white text-black font-bold'
                                      : 'border-[#444444] text-[#cccccc] hover:border-white hover:text-white bg-black'
                                  }`}
                                  title="Copy broadcast sync cue sheet metadata"
                                >
                                  <Copy className="w-2.5 h-2.5" />
                                  <span>{hasCopiedThis ? '✓ CUE SHEET COPIED' : 'CUE SHEET'}</span>
                                </button>

                                {/* 1-Click Certificate */}
                                <button
                                  type="button"
                                  onClick={() => setCertificateTrack(track)}
                                  className="text-[10px] px-2 py-0.5 border border-[#444444] bg-[#121212] text-white hover:border-white hover:bg-white hover:text-black font-bold transition-all flex items-center gap-1"
                                  title="View & export 1-page Synchronization Certificate"
                                >
                                  <ShieldCheck className="w-3 h-3" />
                                  <span>LICENSE CERT</span>
                                </button>
                              </div>
                            </div>

                            {/* Stems Solo Audition + Similar Track Link */}
                            <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pt-1 border-t border-[#141414] text-[10px]">
                              {track.hasStems ? (
                                <div className="flex items-center gap-1.5">
                                  <span className="text-[#666666] uppercase font-bold flex items-center gap-1">
                                    <Layers className="w-3 h-3 text-white" />
                                    <span>STEM AUDITION:</span>
                                  </span>
                                  {(['master', 'drums', 'bass', 'synths'] as StemSoloMode[]).map((mode) => (
                                    <button
                                      key={mode}
                                      type="button"
                                      onClick={() => {
                                        if (!isCurrentActive) handlePlayTrack(track);
                                        handleStemSoloSwitch(mode);
                                      }}
                                      className={`px-1.5 py-0.5 border uppercase ${
                                        isCurrentActive && activeStemSolo === mode
                                          ? 'border-white bg-white text-black font-bold'
                                          : 'border-[#333333] text-[#888888] hover:text-white'
                                      }`}
                                    >
                                      {mode}
                                    </button>
                                  ))}
                                </div>
                              ) : (
                                <span className="text-[#666666]">STEREO MASTER ONLY</span>
                              )}

                              {/* Clean Similar Track Link (No sci-fi jargon) */}
                              <div className="flex items-center gap-1.5 text-[#888888]">
                                <span>SIMILAR TRACK:</span>
                                <button
                                  type="button"
                                  onClick={() => {
                                    const comp = CATALOG.find((t) => t.catalogId === track.companionCatalogId);
                                    if (comp) handlePlayTrack(comp);
                                  }}
                                  className="text-white hover:text-[#cccccc] underline font-bold uppercase"
                                >
                                  {track.companionCatalogId} &bull; {track.companionTitle} ↗
                                </button>
                              </div>
                            </div>
                          </div>
                        )}
                      </>
                    )}
                              </div>
                            );
                          })
                        )}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          )}
        </section>

        {/* ================================================================================== */}
        {/* 4. MAILING LIST (CLEAN, DIRECT, UTILITARIAN RECORD STORE DISPATCH)                 */}
        {/* ================================================================================== */}
        <section className="border border-white bg-[#080808] p-3.5 mb-5 font-mono">
          <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
            <div>
              <div className="flex items-center gap-2 text-white font-bold text-xs uppercase tracking-wider mb-0.5">
                <Mail className="w-4 h-4 text-white" />
                <span>GIVE IT ALL RECORDS // MAILING LIST</span>
              </div>
              <p className="text-xs text-[#aaaaaa]">
                Get notified about new releases, private catalog drops, and bundle discount codes. No spam.
              </p>
            </div>

            {isSubscribed ? (
              <div className="flex items-center gap-2 border border-white bg-[#121212] text-white px-3 py-1.5 text-xs font-bold uppercase">
                <Check className="w-4 h-4 stroke-[3]" />
                <span>[✓ SUBSCRIBED // YOU WILL RECEIVE PRIVATE CATALOG DROPS]</span>
              </div>
            ) : (
              <form onSubmit={handleSubscribe} className="flex items-center gap-2 w-full md:w-auto">
                <input
                  type="email"
                  value={emailInput}
                  onChange={(e) => setEmailInput(e.target.value)}
                  placeholder="ENTER YOUR EMAIL..."
                  required
                  className="bg-black border border-[#444444] px-3 py-1.5 text-xs text-white uppercase outline-none focus:border-white w-full sm:w-64"
                />
                <button
                  type="submit"
                  className="border border-white bg-white text-black text-xs font-bold uppercase px-3 py-1.5 hover:bg-black hover:text-white transition-all whitespace-nowrap"
                >
                  SUBSCRIBE
                </button>
              </form>
            )}
          </div>
        </section>

        {/* ================================================================================== */}
        {/* 5. PERPETUAL LICENSING & LEGAL TERMS ($2,000 / 100K STREAM CEILING ENFORCEMENT)    */}
        {/* ================================================================================== */}
        <section id="licensing-section" className="space-y-3 mb-5 font-mono">
          <div className="border border-white bg-[#080808] transition-all">
            {/* Tactile Hardware Accordion Trigger Header */}
            <button
              type="button"
              onClick={() => setIsLicensingExpanded((prev) => !prev)}
              className="w-full p-3 sm:p-3.5 text-left flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 hover:bg-[#111111] transition-colors cursor-pointer group"
              aria-expanded={isLicensingExpanded}
              title="Toggle Perpetual Licensing & $2,000 Revenue Ceiling Specification"
            >
              <div className="flex items-center gap-2.5">
                <span className="w-6 h-6 border border-white bg-black flex items-center justify-center text-white text-xs font-bold group-hover:bg-white group-hover:text-black transition-colors flex-shrink-0">
                  {isLicensingExpanded ? '−' : '+'}
                </span>
                <div>
                  <div className="text-xs sm:text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
                    <span>{isLicensingExpanded ? 'PERPETUAL LICENSING & $2,000 REVENUE CEILING TERMS' : '[ + ] VIEW PERPETUAL LICENSING & $2,000 REVENUE CEILING TERMS'}</span>
                  </div>
                  <div className="text-[10px] text-[#aaaaaa] mt-0.5 tracking-wide flex items-center gap-2 flex-wrap">
                    <span>100% DIRECT RIGHTS</span>
                    <span>&bull;</span>
                    <span>NEVER CONTENT-ID FLAGGED</span>
                    <span>&bull;</span>
                    <span>PERPETUAL WORLDWIDE SYNC</span>
                  </div>
                </div>
              </div>

              <div className="flex items-center gap-2 self-start sm:self-center">
                <span className="text-[9px] bg-white text-black px-2 py-0.5 font-bold uppercase tracking-wider">
                  {isLicensingExpanded ? 'COLLAPSE TERMS' : 'CLICK TO EXPAND'}
                </span>
                {isLicensingExpanded ? (
                  <ChevronUp className="w-4 h-4 text-white" />
                ) : (
                  <ChevronDown className="w-4 h-4 text-white group-hover:translate-y-0.5 transition-transform" />
                )}
              </div>
            </button>

            {/* Accordion Content Revealed On Click */}
            {isLicensingExpanded && (
              <div className="p-4 pt-2 border-t border-[#222222]">
                <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-[#222222] pb-2 mb-3">
                  <span className="text-[11px] text-white uppercase tracking-wider font-bold">
                    INDEPENDENT MASTER &amp; PUBLISHING LEGAL CLEARANCE
                  </span>
                  <span className="text-[10px] text-[#aaaaaa]">
                    100% OWNED BY LUCIANO LUPINI &bull; CARACAS, VENEZUELA
                  </span>
                </div>

                <p className="text-xs text-[#cccccc] leading-relaxed mb-3">
                  Every recording is 100% written, performed, and mastered by Luciano Lupini in Caracas. 
                  Zero uncleared samples, zero co-writer disputes, and zero publishing middleman hurdles.
                  When you acquire a track, you receive a binding, perpetual non-exclusive sync license.
                </p>

                {/* 4-Pillar Specification Cards */}
                <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2.5 text-xs text-[#888888]">
                  <div className="border border-[#333333] p-2.5 bg-black">
                    <strong className="text-white block mb-0.5">1. UNCOMPRESSED 24-BIT WAV</strong>
                    Studio master 24-bit / 48kHz uncompressed audio. Instant download link upon checkout.
                  </div>

                  <div className="border border-[#333333] p-2.5 bg-black">
                    <strong className="text-white block mb-0.5">2. PERPETUAL WORLDWIDE SYNC</strong>
                    Clearance never expires. Valid for YouTube, Twitch, video games, podcasts, and indie cinema.
                  </div>

                  <div className="border border-[#333333] p-2.5 bg-black">
                    <strong className="text-white block mb-0.5">3. $2,000 / 100K STREAM CEILING</strong>
                    Includes rights for projects generating up to $2,000 USD gross or 100,000 streams. Commercial upgrades available.
                  </div>

                  <div className="border border-[#333333] p-2.5 bg-black">
                    <strong className="text-white block mb-0.5">4. VOCAL LEASE &amp; STEMS</strong>
                    Emcees are cleared to record vocals and distribute songs with zero backend splits owed under the threshold.
                  </div>
                </div>

                {/* Quick Collapse Trigger inside expanded terms */}
                <div className="mt-3 pt-2 border-t border-[#222222] flex justify-end">
                  <button
                    type="button"
                    onClick={() => setIsLicensingExpanded(false)}
                    className="text-[10px] text-white hover:text-[#cccccc] uppercase tracking-wider flex items-center gap-1 font-mono hover:underline cursor-pointer"
                  >
                    <span>[ − ] COLLAPSE</span>
                  </button>
                </div>
              </div>
            )}
          </div>

          {/* Bespoke Production & Contact Line */}
          <div id="about-section" className="border border-[#222222] bg-[#0a0a0a] p-3 text-xs flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
            <div className="text-[#aaaaaa]">
              NEED EXCLUSIVE THEATRICAL SCORE, BESPOKE SOUND DESIGN, OR HIGH-BUDGET COMMERCIAL BUYOUT?
            </div>
            <a
              href="mailto:contact@giveitallrecords.com?subject=BESPOKE%20PRODUCTION%20/%20EXCLUSIVE%20BUYOUT%20INQUIRY"
              className="border border-white bg-white text-black px-3 py-1 font-bold uppercase hover:bg-black hover:text-white transition-all whitespace-nowrap"
            >
              CONTACT: contact@giveitallrecords.com
            </a>
          </div>

          {/* Back to Top Control (Cybernetic Up-Arrow Component) */}
          <div className="mt-3">
            <button
              type="button"
              onClick={() => window.scrollTo({ top: 0, behavior: 'smooth' })}
              className="w-full border-2 border-white hover:border-white bg-black hover:bg-[#111111] p-3 transition-all duration-200 group cursor-pointer text-center relative overflow-hidden shadow-[0_4px_24px_rgba(0,0,0,0.85)] hover:shadow-[0_0_20px_rgba(255,255,255,0.25)]"
              title="Return to top of page (Live Audio Monitor & Store Archive)"
            >
              <div className="flex flex-col sm:flex-row items-center justify-between gap-2.5">
                {/* Left decorative terminal label */}
                {/* Center interactive trigger */}
                <div className="flex items-center gap-3">
                  <div className="w-8 h-8 border border-white bg-[#0a0a0a] group-hover:bg-white flex items-center justify-center transition-all duration-200 shadow-[0_0_8px_rgba(255,255,255,0.15)]">
                    <ChevronsUp className="w-5 h-5 text-white group-hover:text-black group-hover:-translate-y-0.5 transition-all duration-200" />
                  </div>

                  <div className="text-left font-mono">
                    <div className="text-xs sm:text-sm font-bold uppercase tracking-widest text-white transition-colors flex items-center gap-2">
                      <span>[ ^ ] RETURN TO TOP</span>
                      <span className="text-[9px] bg-white text-black px-1.5 py-0.2 font-black uppercase tracking-wider transition-colors">
                        ASCEND
                      </span>
                    </div>
                    <div className="text-[10px] text-[#888888] uppercase tracking-wider flex items-center gap-1.5 mt-0.5">
                      <span>AUDIO CONTROLS</span>
                      <span>&bull;</span>
                      <span>FULL CATALOG</span>
                      <span>&bull;</span>
                      <span className="text-white">CRATE ({favorites.length})</span>
                    </div>
                  </div>

                  <div className="w-8 h-8 border border-white bg-[#0a0a0a] group-hover:bg-white flex items-center justify-center transition-all duration-200 shadow-[0_0_8px_rgba(255,255,255,0.15)]">
                    <ChevronsUp className="w-5 h-5 text-white group-hover:text-black group-hover:-translate-y-0.5 transition-all duration-200" />
                  </div>
                </div>
              </div>
            </button>
          </div>
        </section>

        {/* ================================================================================== */}
        {/* FOOTER (CLEAN & DIRECT)                                                            */}
        {/* ================================================================================== */}
        <footer className="border-t border-[#222222] pt-3 text-center text-xs text-[#555555] uppercase tracking-wider font-mono">
          <div className="flex flex-col sm:flex-row justify-between items-center gap-2 mb-1">
            <div>&copy; 2026 GIVE IT ALL RECORDS. ALL RIGHTS RESERVED.</div>
            <div className="text-[10px] text-[#aaaaaa]">
