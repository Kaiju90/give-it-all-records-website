                    favorites.length > 0 
                      ? 'border-white bg-[#181818] text-white hover:bg-white hover:text-black shadow-[0_0_8px_rgba(255,255,255,0.2)]' 
                      : 'border-[#333333] text-[#888888] hover:text-white'
                  }`}
                  title="Open your project crate"
                >
                  <ShoppingBag className="w-3 h-3" />
                  <span>CRATE ({favorites.length})</span>
                </button>

                <button
                  type="button"
                  onClick={() => {
                    setModalTrack(currentTrack);
                    setModalTier('master');
